---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RapidPage from '../../../components/demo/rapid/RapidPage.astro';
import FontFaces from '../../../components/ui/FontFaces.astro';
import { getDemo } from '../../../site/get-demo';
import { fontSets } from '../../../site/fonts';

const demo = getDemo('creative');
---

<BaseLayout
  title={`Демо: ${demo.title}`}
  bodyClass="bg-paper text-volt"
  themeColor="#ffffff"
  skipLinkClass="bg-volt text-paper focus-visible:outline-volt"
>
  <FontFaces slot="head" set={fontSets.creative} />
  <RapidPage />
</BaseLayout>
