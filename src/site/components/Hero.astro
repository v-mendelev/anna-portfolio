---
/**
 * Hero, composed on the thirds: the name fills the top band, a still frame
 * the middle, the pitch and the two actions the bottom. Rule-of-thirds guides
 * sit behind everything (desktop). On phones the pitch and actions come right
 * after the name, so "Обсудить проект" is on the first screen.
 */
import FootageFrame from '../../components/ui/FootageFrame.astro';
import Icon from '../../components/ui/Icon.astro';
import { content } from '../content';

const { hero, person } = content;
const [first = person.name, ...rest] = person.name.split(' ');
const tagClass = 'absolute bottom-2 left-2 bg-paper px-1.5 py-0.5 text-xs font-semibold';
---

<section id="top" class="kadr-hero relative overflow-hidden">
  <div class="kadr-wrap relative grid grid-cols-6 gap-x-4 pt-5 pb-14 lg:grid-cols-12 lg:gap-x-6 lg:pt-8 lg:pb-20">
    <div class="kadr-guides" aria-hidden="true"></div>
    <h1 class="kadr-name col-span-6 uppercase max-lg:order-1 lg:col-span-12">
      <span class="block lg:pl-[var(--third)]">{first}</span>
      <span class="block">{rest.join(' ')}</span>
    </h1>
    <div class="kadr-frame relative col-span-6 mt-8 max-lg:order-3 lg:col-span-8 lg:col-start-5 lg:row-span-2 lg:mt-10">
      <span class="vf" aria-hidden="true"></span>
      <FootageFrame
        tone={{ from: '#0b16a8', to: '#e6e8ff' }}
        paint="none"
        ratio="16 / 9"
        class="kadr-slate"
        description="Кадр из работы Анны Шеленковой: интро подкаста"
        poster={hero.still?.poster}
        posterAvif={hero.still?.posterAvif}
        placeholderDetail="кадр из работ"
        tagClass={tagClass}
        eager
      />
    </div>
    <div class="col-span-6 mt-6 max-lg:order-2 lg:col-span-4 lg:col-start-1 lg:row-start-2 lg:mt-10 lg:self-end">
      <p class="max-w-[18em] text-xl leading-snug font-semibold tracking-[-0.01em] lg:text-2xl">
        {hero.lead}
      </p>
      {hero.next && <p class="mt-3 text-sm font-medium">{hero.next}</p>}
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#contact" class="kadr-btn kadr-btn--solid">
          Обсудить проект
        </a>
        <a href="#showreel" class="kadr-btn" data-testid="showreel-open">
          <Icon name="play" class="size-4" /> Смотреть шоурил
        </a>
      </div>
    </div>
  </div>
</section>
