---
/** Footer: name, a way back up, and an honest note while content is pending. */
import { content } from '../content';

const { person, projects, showreel } = content;
// Name exactly what is still a placeholder, nothing that is already real.
// A missing contact link is labelled in the contact list itself.
const pendingParts = [
  projects.some((p) => p.placeholder) && 'работы',
  showreel.placeholder && 'шоурил',
  !person.portrait && 'фото',
  person.placeholderBio && 'текст о себе',
].filter((part): part is string => Boolean(part));
const pending =
  pendingParts.length > 0
    ? `${pendingParts.slice(0, -1).join(', ')}${pendingParts.length > 1 ? ' и ' : ''}${pendingParts.at(-1) ?? ''}`
    : '';
const year = new Date().getFullYear();
---

<footer class="kadr-wrap pb-10" data-page-region>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t-2 border-volt pt-4 text-sm font-semibold">
    <p>
      © {year} {person.name}
    </p>
    {pending && <p data-footer-note>Сайт наполняется: {pending} — заглушки.</p>}
    <a href="#top" class="kadr-tap kadr-link -mr-3">
      Наверх
    </a>
  </div>
</footer>
