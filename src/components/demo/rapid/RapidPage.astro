---
/**
 * Concept C — RAPID ("рапид", slow motion / speed ramp): type that behaves
 * like footage. One variable family (Noto Sans Display, weight + width axes); the
 * identity is the contrast of widths, which holds with no animation at all.
 * Signatures:
 *  - the header is a timeline: section clips plus a progress fill driven by
 *    page scroll (CSS scroll-driven, transform only); it docks in once the
 *    hero has passed;
 *  - the name is set wide over ultra-condensed; scrolling ramps it (scaleX on
 *    the visual layer, never re-laying out the font);
 *  - work is a reel of frames (native scroll-snap); the frame under the
 *    playhead "freezes" and shows its details.
 * Per-frame work: none in JS. Scroll effects are CSS on the compositor;
 * JS only reacts to IntersectionObserver callbacks and clicks.
 */
import FootageFrame from '../../ui/FootageFrame.astro';
import Icon from '../../ui/Icon.astro';
import PlaceholderTag from '../../ui/PlaceholderTag.astro';
import SmearHeading from './SmearHeading.astro';
import { withBase } from '../../../lib/paths';
import { usedCategories } from '../../../lib/portfolio';
import {
  DEMO_PROJECT_LABEL,
  DEMO_WORK_NOTE,
  HERO,
  SECTIONS,
  TRAVEL_HEADING,
  categoryLabel,
  content,
  serviceTitle,
} from '../../../site/content';

const { person, services, projects, travel, testimonials, contacts } = content;
const categories = usedCategories(content.categories, projects);
const clipLinks = SECTIONS;
/** Relative length of each section on the timeline (roughly its page share). */
const clipWeight: Record<string, number> = {
  showreel: 1,
  work: 3,
  services: 2,
  travel: 2,
  about: 1,
  reviews: 1,
  contact: 1,
};
/**
 * Services as a speed ramp: one cap height for all four, only the width
 * changes (condensed to normal), so the rows end ragged and no service looks
 * more important than another. `size` is font-size in cqi (percent of the
 * row's own width, via container queries): the longest title just fits.
 */
const ramp: Record<string, { width: number; size: number }> = {
  production: { width: 62.5, size: 9.1 },
  editing: { width: 100, size: 9.1 },
  voice: { width: 87.5, size: 9.1 },
  travel: { width: 75, size: 9.1 },
};
/**
 * Inline style for a width (font-stretch 62.5–100%). Condensed widths switch
 * to a fallback whose size-adjust matches them while the web font loads.
 */
const wdth = (n: number) =>
  `font-stretch: ${n}%; font-family: ${n <= 75 ? 'var(--font-rp-condensed)' : 'var(--font-rp)'}`;
const pad = (n: number) => String(n).padStart(2, '0');
const tag = 'absolute bottom-2 left-2 bg-paper px-1.5 py-0.5 text-xs font-semibold text-volt';
---

<div class="rp min-h-dvh bg-paper font-rp text-volt" data-concept="creative">
  <header class="rp-header sticky top-0 z-40 bg-paper" data-site-header data-solid-after="#top">
    <div class="rp-wrap flex h-14 items-center justify-between gap-4">
      <a
        href="#top"
        class="rp-tap text-lg leading-none font-[900]"
        style="font-stretch: 100%; font-family: var(--font-rp)"
      >
        {person.name}
      </a>
      <nav aria-label="Разделы" class="hidden items-stretch gap-0.5 lg:flex">
        {clipLinks.map((s) => (
          <a href={`#${s.id}`} class="rp-clip" data-clip={s.id}>
            {s.label}
          </a>
        ))}
      </nav>
      <button
        type="button"
        class="rp-tap gap-2 px-1 text-sm font-bold lg:hidden"
        data-menu-toggle
        aria-controls="rp-menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="size-5" />
        Меню
      </button>
    </div>
    {/* The timeline: one segment per section, a fill for page progress. */}
    <div class="rp-track" aria-hidden="true">
      {clipLinks.map((s) => (
        <span class="rp-seg" style={`flex-grow: ${clipWeight[s.id] ?? 1}`} data-seg={s.id}></span>
      ))}
      <span class="rp-progress"></span>
    </div>
  </header>

  <div
    id="rp-menu"
    class="fixed inset-0 z-50 overflow-y-auto bg-paper"
    role="dialog"
    aria-modal="true"
    aria-label="Меню"
    data-menu-modal
    hidden
  >
    <div class="rp-wrap flex h-14 items-center justify-between border-b-2 border-volt">
      <span class="font-[900]" style="font-stretch: 100%; font-family: var(--font-rp)">
        {person.name}
      </span>
      <button
        type="button"
        class="-mr-2.5 grid size-11 place-items-center"
        data-menu-close
        aria-label="Закрыть меню"
      >
        <Icon name="close" />
      </button>
    </div>
    <nav aria-label="Меню" class="rp-wrap py-4">
      <ul>
        {SECTIONS.map((s, i) => (
          <li>
            <a
              href={`#${s.id}`}
              class="flex min-h-14 items-center text-[clamp(2.5rem,12vw,5rem)] leading-none font-[900]"
              style={wdth([100, 92, 85, 78, 70, 66, 62.5][i] ?? 100)}
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={withBase('/design/')} class="rp-tap mt-6 gap-2 text-sm font-semibold">
        <Icon name="back" class="size-4" /> Все концепции
      </a>
    </nav>
  </div>

  <main id="main">
    <section id="top" class="rp-hero">
      <div class="rp-wrap pt-4 pb-12 lg:grid lg:grid-cols-12 lg:gap-x-6 lg:pt-8 lg:pb-20">
        <h1 class="rp-name lg:col-span-12">
          <span class="rp-name-wide">Анна</span>
          <span class="rp-name-tight">Шеленкова</span>
        </h1>
        <div class="relative mt-4 lg:col-span-8 lg:col-start-5 lg:row-start-2 lg:mt-8">
          <FootageFrame
            tone={{ from: '#0b16a8', to: '#e6e8ff' }}
            paint="none"
            ratio="16 / 9"
            class="rp-frame"
            description="Кадр из шоурила"
            placeholderDetail="кадр шоурила"
            tagClass={tag}
            eager
          >
            <span class="rp-frame-tc" aria-hidden="true">
              Шоурил
            </span>
            <span class="rp-frame-play" aria-hidden="true">
              <Icon name="play" class="size-7 lg:size-10" />
            </span>
          </FootageFrame>
          <button
            type="button"
            class="absolute inset-0"
            data-dialog-open="rp-reel"
            aria-label="Смотреть шоурил"
          ></button>
        </div>
        <div class="mt-6 lg:col-span-4 lg:col-start-1 lg:row-start-2 lg:mt-8 lg:self-start">
          <p class="max-w-[32ch] text-lg leading-snug font-[560] lg:text-xl">{HERO.lead}</p>
          <p class="mt-2 text-sm font-medium">{HERO.next}</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="#contact" class="rp-btn rp-btn--solid">
              Обсудить проект
            </a>
            <button
              type="button"
              class="rp-btn"
              data-dialog-open="rp-reel"
              data-testid="showreel-open"
            >
              <Icon name="play" class="size-4" /> Шоурил
            </button>
          </div>
        </div>
      </div>
    </section>

    <section id="showreel" class="rp-section">
      <div class="rp-wrap grid gap-x-6 gap-y-6 lg:grid-cols-12">
        <SmearHeading text="Шоурил" width={62.5} class="rp-h2 lg:col-span-4" />
        <div class="lg:col-span-7 lg:col-start-6 lg:pt-6">
          <p class="max-w-[38ch] text-lg leading-relaxed">
            Лучшие кадры из разных проектов в одном ролике: съёмка, монтаж и голос. Смотрите со
            звуком.
          </p>
          <p class="mt-3 text-sm font-semibold">
            <PlaceholderTag detail="видео появится позже" />
          </p>
        </div>
      </div>
    </section>

    <section id="work" class="rp-section">
      <div class="mx-auto max-w-wide" data-testid="page-container" data-filter-root>
        <div class="rp-wrap grid gap-x-6 gap-y-5 lg:grid-cols-12">
          <SmearHeading text="Работы" width={62.5} class="rp-h2 lg:col-span-4" />
          <div class="lg:col-span-7 lg:col-start-6 lg:pt-4">
            <p class="max-w-[50ch] text-base leading-relaxed font-medium" data-demo-note>
              {DEMO_WORK_NOTE}
            </p>
            <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Фильтр работ">
              <button type="button" class="rp-filter" data-filter="all" aria-pressed="true">
                Все
              </button>
              {categories.map((c) => (
                <button type="button" class="rp-filter" data-filter={c.id} aria-pressed="false">
                  {c.label}
                </button>
              ))}
            </div>
            <p
              class="mt-2 text-sm font-semibold"
              data-filter-status
              data-template="Кадров в ленте: {n}"
              aria-live="polite"
            >
              Кадров в ленте: {projects.length}
            </p>
          </div>
        </div>

        <div class="rp-reel-wrap relative mt-10">
          <ol class="rp-reel" data-project-list data-reel aria-label="Лента работ" tabindex="0">
            {projects.map((p, i) => (
              <li data-category={p.category} class="rp-reel-item" data-reel-item>
                <article>
                  <FootageFrame
                    tone={p.tone}
                    paint="none"
                    ratio="16 / 10"
                    class="rp-frame rp-reel-frame"
                    description={`Кадр из проекта «${p.title}»`}
                    placeholder={p.placeholder}
                    placeholderDetail={DEMO_PROJECT_LABEL}
                    tagClass={tag}
                  >
                    <span class="rp-frame-tc" aria-hidden="true">
                      {pad(i + 1)} / {pad(projects.length)}
                    </span>
                  </FootageFrame>
                  <h3
                    class="mt-3 text-[1.625rem] leading-none font-[800]"
                    style="font-stretch: 75%; font-family: var(--font-rp-condensed)"
                  >
                    {p.title}
                  </h3>
                  <p class="mt-1.5 text-sm font-medium">
                    {categoryLabel(p.category)}
                    {p.place && <span>, {p.place.toLowerCase()}</span>}
                  </p>
                  <p class="rp-reel-more mt-2 text-sm font-semibold">
                    Что я делаю в таком проекте:{' '}
                    {p.roles.map(serviceTitle).join(', ').toLowerCase()}
                  </p>
                </article>
              </li>
            ))}
          </ol>
          <div class="rp-wrap mt-4 flex items-center justify-center gap-2">
            <button type="button" class="rp-step" data-reel-prev aria-label="Предыдущий кадр">
              <Icon name="back" class="size-5" />
            </button>
            <button type="button" class="rp-step" data-reel-next aria-label="Следующий кадр">
              <Icon name="arrow" class="size-5" />
            </button>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="rp-section">
      <div class="rp-wrap">
        <SmearHeading text="Услуги" width={62.5} class="rp-h2" />
        <p class="mt-4 max-w-[40ch] text-lg">Можно заказать всё вместе или одну часть работы.</p>
        {/* A speed ramp down the list: the same column, four different widths. */}
        <dl class="mt-10">
          {services.map((s) => {
            const r = ramp[s.id] ?? { width: 100, size: 12 };
            return (
              <div class="grid gap-x-6 gap-y-2 border-t-2 border-volt py-5 lg:grid-cols-12 lg:items-end">
                <dt class="rp-ramp lg:col-span-8" style={`${wdth(r.width)}; --rp-size: ${r.size}`}>
                  <span class="rp-ramp-text">{s.title}</span>
                </dt>
                <dd class="lg:col-span-4">
                  <p class="text-lg leading-snug font-[560]">{s.summary}</p>
                  <p class="mt-1 text-sm leading-relaxed">{s.includes.join(', ')}</p>
                </dd>
              </div>
            );
          })}
        </dl>
      </div>
    </section>

    <section id="travel" class="rp-section">
      <div class="rp-wrap">
        <div class="grid gap-x-6 gap-y-5 lg:grid-cols-12">
          <SmearHeading
            text={TRAVEL_HEADING.main}
            width={62.5}
            class="rp-h2 lg:col-span-7"
            style="--rp-h2-vw: 14.6vw"
          >
            <span class="rp-h2-sub" style="font-stretch: 100%; font-family: var(--font-rp)">
              {TRAVEL_HEADING.sub}
            </span>
          </SmearHeading>
          <p class="max-w-[40ch] text-xl leading-snug font-[560] lg:col-span-5 lg:pt-6">
            {travel.intro}
          </p>
        </div>
        <ol class="mt-10 grid grid-cols-2 gap-x-3 gap-y-6 lg:grid-cols-4 lg:gap-x-4">
          {travel.steps.map((step, i) => (
            <li>
              <div class="rp-frame relative aspect-[16/10]">
                <span class="rp-frame-tc" aria-hidden="true">
                  {pad(i + 1)}
                </span>
              </div>
              <h3 class="mt-2 text-lg font-[800]">{step.title}</h3>
              <p class="mt-1 text-sm leading-relaxed">{step.text}</p>
            </li>
          ))}
        </ol>
        <h3 class="mt-10 text-sm font-bold">Что получите</h3>
        <ul class="mt-2 flex flex-wrap gap-2">
          {travel.formats.map((f) => (
            <li class="bg-volt px-3 py-1.5 text-sm font-semibold text-paper">{f}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="about" class="rp-section">
      <div class="rp-wrap grid items-end gap-x-6 gap-y-8 lg:grid-cols-12">
        <div class="w-2/3 lg:col-span-4 lg:w-auto">
          <FootageFrame
            tone={{ from: '#0b16a8', to: '#e6e8ff' }}
            paint="none"
            ratio="4 / 5"
            class="rp-frame"
            description="Портрет Анны"
            placeholderDetail="фото Анны"
            tagClass={tag}
          />
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <SmearHeading text="Обо мне" width={62.5} class="rp-h2" />
          <p class="mt-5 max-w-[52ch] text-xl leading-relaxed">{person.bio}</p>
          {person.placeholderBio && (
            <PlaceholderTag detail="текст об Анне" class="mt-4 text-sm font-semibold" />
          )}
        </div>
      </div>
    </section>

    <section id="reviews" class="rp-section">
      <div class="rp-wrap">
        <SmearHeading text="Отзывы" width={62.5} class="rp-h2" />
        <div class="mt-10 grid gap-x-6 gap-y-10 lg:grid-cols-2">
          {testimonials.map((t) => (
            <figure>
              <blockquote
                class="text-[clamp(1.5rem,5vw,2.25rem)] leading-[1.1] font-bold"
                style="font-stretch: 87.5%; font-family: var(--font-rp)"
              >
                {t.quote}
              </blockquote>
              <figcaption class="mt-3 text-sm font-semibold">
                {t.author}
                {t.company && `, ${t.company}`}
                {t.placeholder && <PlaceholderTag detail="реальный отзыв" class="mt-1 block" />}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="bg-volt-deep text-paper">
      <div class="rp-wrap pt-16 pb-10 lg:pt-24">
        <h2 class="rp-contact">
          <span class="block" style="font-stretch: 100%; font-family: var(--font-rp)">
            Обсудить
          </span>
          <span class="block" style="font-stretch: 100%; font-family: var(--font-rp)">
            проект
          </span>
        </h2>
        <p class="mt-6 max-w-[40ch] text-xl leading-snug font-[560]">
          Что снимаем, где и когда? Отвечу и предложу план.
        </p>
        <dl class="mt-10 grid gap-x-6 sm:grid-cols-3" data-contacts>
          {contacts.map((c) => (
            <div class="border-t-2 border-paper py-4">
              <dt
                class="text-3xl leading-none font-[900]"
                style="font-stretch: 100%; font-family: var(--font-rp)"
              >
                {c.label}
              </dt>
              <dd class="mt-2 text-sm font-semibold">
                {c.href ? (
                  <a href={c.href}>{c.value}</a>
                ) : (
                  <PlaceholderTag detail="контакт появится" />
                )}
              </dd>
            </div>
          ))}
        </dl>
        <footer class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t-2 border-paper pt-4 text-sm font-semibold">
          <a href={withBase('/design/')} class="rp-tap gap-2" data-testid="back-to-design">
            <Icon name="back" class="size-4" /> Все концепции
          </a>
          <p>Концепция «Рапид». Работы, отзывы и контакты — заглушки.</p>
        </footer>
      </div>
    </section>
  </main>

  <dialog
    id="rp-reel"
    data-dialog
    aria-label="Шоурил"
    class="m-auto w-[min(72rem,calc(100vw-2rem))] max-w-none bg-paper p-0 text-volt backdrop:bg-volt-deep/90"
  >
    <div class="flex h-14 items-center justify-between border-b-2 border-volt px-4">
      <p class="text-xl font-[900]" style="font-stretch: 100%; font-family: var(--font-rp)">
        Шоурил
      </p>
      <button
        type="button"
        class="-mr-2.5 grid size-11 place-items-center"
        data-dialog-close
        aria-label="Закрыть шоурил"
      >
        <Icon name="close" />
      </button>
    </div>
    <div class="p-4 sm:p-6">
      <FootageFrame
        tone={{ from: '#0b16a8', to: '#e6e8ff' }}
        paint="none"
        ratio="16 / 9"
        class="rp-frame"
        description="Видео шоурила"
        placeholderDetail="видео шоурила"
        tagClass={tag}
      />
      <p class="mt-4 text-sm font-semibold">Здесь будет плеер со звуком, когда появится шоурил.</p>
    </div>
  </dialog>
</div>

<script>
  import { initDialogs } from '../../../lib/ui/dialog';
  import { initFilters } from '../../../lib/ui/filter';
  import { initHeaderState } from '../../../lib/ui/header';
  import { initMenus } from '../../../lib/ui/menu';

  initMenus();
  initDialogs();
  initFilters();
  initHeaderState();

  // Timeline: highlight the clip of the section in view (observer, not scroll).
  const segs = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-seg]')].map((el) => [el.dataset.seg, el]),
  );
  const clips = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-clip]')].map((el) => [el.dataset.clip, el]),
  );
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const id = entry.target.id;
        for (const [key, el] of segs) el.toggleAttribute('data-active', key === id);
        for (const [key, el] of clips) {
          if (key === id) el.setAttribute('aria-current', 'true');
          else el.removeAttribute('aria-current');
        }
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  for (const id of segs.keys()) {
    const section = id ? document.getElementById(id) : null;
    if (section) sectionObserver.observe(section);
  }

  // Reel: the frame under the playhead (centre of the strip) is "frozen".
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  if (reel) {
    const items = [...reel.querySelectorAll<HTMLElement>('[data-reel-item]')];
    const freeze = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.toggleAttribute('data-active', entry.isIntersecting);
        }
      },
      { root: reel, rootMargin: '0px -42% 0px -42%' },
    );
    for (const item of items) freeze.observe(item);

    const step = (dir: 1 | -1) => {
      const visible = items.filter((item) => !item.hidden);
      const current = visible.findIndex((item) => item.hasAttribute('data-active'));
      const next = visible[Math.min(visible.length - 1, Math.max(0, current + dir))];
      next?.scrollIntoView({ block: 'nearest', inline: 'center' });
    };
    document.querySelector('[data-reel-prev]')?.addEventListener('click', () => step(-1));
    document.querySelector('[data-reel-next]')?.addEventListener('click', () => step(1));
    reel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        step(event.key === 'ArrowRight' ? 1 : -1);
      }
    });
  }
</script>

<style is:global>
  html:has(.rp) {
    scrollbar-color: var(--color-volt) var(--color-paper);
  }
  html[data-menu-open] {
    overflow: hidden;
  }
  .rp :focus-visible {
    outline: 3px solid var(--color-volt);
    outline-offset: 3px;
  }
  .rp .bg-volt-deep :focus-visible {
    outline-color: var(--color-paper);
  }
  .rp ::selection {
    background: var(--color-volt);
    color: var(--color-paper);
  }

  .rp-wrap {
    margin-inline: auto;
    max-width: var(--container-wide);
    padding-inline: 1rem;
  }
  @media (min-width: 64rem) {
    .rp-wrap {
      padding-inline: 2rem;
    }
  }
  /* In the components layer so responsive utilities (lg:hidden) still win. */
  @layer components {
    .rp-tap {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
    }
  }
  .rp-section {
    border-top: 2px solid var(--color-volt);
    padding-block: 4rem;
  }
  @media (min-width: 64rem) {
    .rp-section {
      padding-block: 6rem;
    }
  }

  /* Timeline header. Clips (desktop) are links; the track below shows every
     section as a segment and page progress as a fill. */
  .rp-header {
    border-bottom: 2px solid var(--color-volt);
  }
  .rp-clip {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0 0.7rem;
    font-size: 0.875rem;
    font-weight: 700;
    font-stretch: 87.5%;
  }
  .rp-clip:hover,
  .rp-clip[aria-current] {
    background: var(--color-volt);
    color: var(--color-paper);
  }
  .rp-track {
    position: relative;
    display: flex;
    gap: 2px;
    height: 0.375rem;
    overflow: hidden;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.3s ease-out;
  }
  /* The track docks in once the hero (the reel's own frame) has passed. */
  .rp-header:not([data-scrolled]) .rp-track {
