---
/** Clickable card: whole surface is a single link. */
export interface Props {
  href: string;
  title: string;
  description?: string;
  testId?: string;
}

const { href, title, description, testId } = Astro.props;
---

<a
  href={href}
  data-testid={testId}
  class="group border-line bg-surface-raised hover:border-accent block h-full rounded-xl border p-5 transition-colors sm:p-6"
>
  <h2 class="group-hover:text-accent text-xl font-semibold tracking-tight">{title}</h2>
  {description && (
    <p class="text-ink-muted mt-2 text-sm leading-relaxed sm:text-base">{description}</p>
  )}
  <span class="text-accent mt-4 inline-block text-sm font-medium" aria-hidden="true">
    Открыть →
  </span>
</a>
