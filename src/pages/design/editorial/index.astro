---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EditorialPage from '../../../components/demo/editorial/EditorialPage.astro';
import FontFaces from '../../../components/ui/FontFaces.astro';
import { getDemo } from '../../../site/get-demo';
import { fontSets } from '../../../site/fonts';

const demo = getDemo('editorial');
---

<BaseLayout
  title={`Демо: ${demo.title}`}
  bodyClass="bg-ed-paper text-ed-ink"
  themeColor="#f5f6f3"
  skipLinkClass="bg-ed-water text-ed-paper"
>
  <FontFaces slot="head" set={fontSets.editorial} />
  <EditorialPage />
</BaseLayout>
