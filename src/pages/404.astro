---
import SiteLayout from '../site/components/SiteLayout.astro';
import { withBase } from '../lib/paths';
---

<SiteLayout title="Страница не найдена" noindex>
  <div class="kadr">
    <main id="main" class="kadr-wrap py-16 lg:py-24" data-testid="page-container">
      <div class="relative max-w-3xl px-5 py-10 sm:px-10">
        <span class="vf vf--lg" aria-hidden="true"></span>
        <p class="text-sm font-semibold">Ошибка 404</p>
        <h1 class="kadr-h2 mt-3">Страница не найдена</h1>
        <p class="mt-6 max-w-[24em] text-lg font-medium">
          Такой страницы нет. Работы, услуги и контакты — на главной.
        </p>
        <a href={withBase('/')} class="kadr-btn kadr-btn--solid mt-8">
          На главную
        </a>
      </div>
    </main>
  </div>
</SiteLayout>
