---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SkleykaPage from '../../../components/demo/skleyka/SkleykaPage.astro';
import FontFaces from '../../../components/ui/FontFaces.astro';
import { getDemo } from '../../../site/get-demo';
import { fontSets } from '../../../site/fonts';

const demo = getDemo('editorial');
---

<BaseLayout
  title={`Демо: ${demo.title}`}
  bodyClass="bg-paper text-pitch"
  themeColor="#ffffff"
  skipLinkClass="bg-pitch text-paper focus-visible:outline-volt"
>
  <FontFaces slot="head" set={fontSets.editorial} />
  <SkleykaPage />
</BaseLayout>
