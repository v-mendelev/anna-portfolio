---
/**
 * Showreel. With a video file in content it renders a native player
 * (controls, sound); until then a labelled placeholder frame — never an
 * empty player or a play button that does nothing.
 */
import FootageFrame from '../../components/ui/FootageFrame.astro';
import PlaceholderTag from '../../components/ui/PlaceholderTag.astro';
import { mediaState } from '../../lib/portfolio';
import { content } from '../content';

const { showreel } = content;
const state = mediaState(showreel);
---

<section id="showreel" class="border-t-2 border-volt">
  <div class="kadr-wrap grid gap-x-6 gap-y-8 py-16 lg:grid-cols-12 lg:py-24">
    <div class="lg:col-span-5">
      <h2 class="kadr-h2">{showreel.title}</h2>
      <p class="mt-5 max-w-[20em] text-lg leading-relaxed font-medium">{showreel.description}</p>
      {showreel.durationLabel && state === 'video' && (
        <p class="mt-3 text-sm font-semibold">{showreel.durationLabel}</p>
      )}
      {state === 'placeholder' && (
        <p class="mt-3 text-sm font-semibold">
          <PlaceholderTag detail="видео появится позже" />
        </p>
      )}
    </div>
    <div class="kadr-frame relative lg:col-span-7" data-showreel-media={state}>
      <span class="vf" aria-hidden="true"></span>
      <FootageFrame
        tone={{ from: '#0b16a8', to: '#e6e8ff' }}
        paint="none"
        ratio="16 / 9"
        class="kadr-slate"
        description="Шоурил Анны Шеленковой"
        video={showreel.video}
        poster={showreel.poster}
        placeholder={showreel.placeholder}
        player
        tag={false}
      />
    </div>
  </div>
</section>
