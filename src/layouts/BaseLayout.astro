---
/**
 * Root HTML document. Every page renders through this layout.
 * Generic: project data comes from src/site/site.config.ts.
 */
import '../styles/global.css';
import { env } from '../config/features';
import { withBase } from '../lib/paths';
import { siteConfig } from '../site/site.config';

export interface Props {
  /** Page title; rendered as "<title> — <site name>". */
  title?: string;
  /** Complete <title>, used as is. Wins over `title`. */
  fullTitle?: string;
  description?: string;
  /** Force noindex regardless of PUBLIC_SITE_INDEXABLE. */
  noindex?: boolean;
  /** Canonical path (relative to the base) when it differs from this page's URL. */
  canonicalPath?: string;
  /** Extra classes for <body> (page-level theme: background, text, selection). */
  bodyClass?: string;
  /** Browser UI colour (mobile address bar). */
  themeColor?: string;
  /** Skip-link styling for the page theme. */
  skipLinkClass?: string;
}

const {
  title,
  fullTitle: explicitTitle,
  description = siteConfig.description,
  noindex = false,
  canonicalPath,
  bodyClass,
  themeColor = siteConfig.themeColor,
  skipLinkClass = 'bg-accent text-accent-ink',
} = Astro.props;
const fullTitle =
  explicitTitle ??
  (title ? `${title} — ${siteConfig.name}` : (siteConfig.homeTitle ?? siteConfig.name));
const canonical = new URL(
  canonicalPath ? withBase(canonicalPath) : Astro.url.pathname,
  Astro.site,
).toString();
const robots = noindex || !env.indexable ? 'noindex, nofollow' : 'index, follow';
const og = siteConfig.ogImage;
const ogImage = og ? new URL(withBase(og.path), Astro.site).toString() : undefined;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    {themeColor && <meta name="theme-color" content={themeColor} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:url" content={canonical} />
    {og && ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content={String(og.width)} />
        <meta property="og:image:height" content={String(og.height)} />
        <meta property="og:image:alt" content={og.alt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a
      href="#main"
      class:list={[
        'sr-only rounded px-3 py-2 focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:inline-flex focus:min-h-11 focus:items-center',
        skipLinkClass,
      ]}
    >
      Перейти к содержимому
    </a>
    <slot />
  </body>
</html>
