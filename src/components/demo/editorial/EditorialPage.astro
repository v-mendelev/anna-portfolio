---
/**
 * Concept B — Editorial: "the atlas".
 * A contemporary travel monograph on cool uncoated paper: asymmetric spreads,
 * a serif with optical sizes, captions written like map legends.
 * Signatures: the index of works (rows open in place; on desktop a frame
 * follows the pointer), the shooting route drawn as a dotted line.
 */
import FootageFrame from '../../ui/FootageFrame.astro';
import Icon from '../../ui/Icon.astro';
import PlaceholderTag from '../../ui/PlaceholderTag.astro';
import { withBase } from '../../../lib/paths';
import { usedCategories } from '../../../lib/portfolio';
import {
  DEMO_PROJECT_LABEL,
  DEMO_WORK_NOTE,
  SECTIONS,
  categoryLabel,
  content,
  serviceTitle,
} from '../../../site/content';

const { person, services, projects, travel, testimonials, contacts } = content;
const categories = usedCategories(content.categories, projects);
const tagClass = 'mt-2 block text-xs text-ed-muted';
---

<div class="ed bg-ed-paper font-ed-sans text-ed-ink" data-concept="editorial">
  <header class="sticky top-0 z-40 border-b border-ed-line bg-ed-paper" data-site-header>
    <div class="mx-auto flex h-16 max-w-wide items-center justify-between gap-6 px-4 sm:px-8">
      <a href="#top" class="inline-flex min-h-11 items-center font-ed-serif text-lg font-medium">
        {person.name}
      </a>
      <nav aria-label="Разделы" class="hidden gap-7 text-sm lg:flex">
        {SECTIONS.map((s) => (
          <a href={`#${s.id}`} class="ed-link">
            {s.label}
          </a>
        ))}
      </nav>
      <button
        type="button"
        class="flex min-h-11 items-center gap-2 text-sm lg:hidden"
        data-menu-toggle
        aria-controls="ed-menu"
        aria-expanded="false"
      >
        <Icon name="menu" />
        <span>Содержание</span>
      </button>
    </div>
    <div id="ed-menu" class="border-t border-ed-line bg-ed-paper lg:hidden" hidden>
      <nav aria-label="Содержание" class="mx-auto max-w-wide px-4 pt-4 pb-8 sm:px-8">
        <ol class="divide-y divide-ed-line">
          {SECTIONS.map((s) => (
            <li>
              <a href={`#${s.id}`} class="flex min-h-12 items-center font-ed-serif text-2xl">
                {s.label}
              </a>
            </li>
          ))}
        </ol>
        <div class="mt-6 flex items-center justify-between">
          <a
            href={withBase('/design/')}
            class="inline-flex min-h-11 items-center gap-2 text-sm text-ed-muted"
          >
            <Icon name="back" class="size-4" /> Все концепции
          </a>
          <button type="button" class="min-h-11 text-sm text-ed-muted" data-menu-close>
            Закрыть
          </button>
        </div>
      </nav>
    </div>
  </header>

  <main id="main">
    <section
      id="top"
      class="mx-auto grid max-w-wide grid-cols-12 gap-x-6 px-4 pt-10 pb-24 sm:px-8 lg:grid-rows-[auto_1fr] lg:pt-16"
    >
      <h1 class="col-span-12 font-ed-serif max-lg:order-1 text-[clamp(3rem,12.5vw,6rem)] leading-[0.92] font-light tracking-[-0.035em] lg:col-span-7 lg:text-[clamp(3.5rem,7.2vw,6rem)]">
        <span class="block">Анна</span>
        <span class="block pl-[10%]">Шеленкова</span>
      </h1>
      <div class="col-span-12 mt-8 sm:col-span-8 max-lg:order-3 lg:col-span-4 lg:col-start-2 lg:row-start-2 lg:mt-10">
        <p class="font-ed-serif text-lg leading-relaxed sm:text-2xl">
          Видеограф. Снимаю места и людей, монтирую и озвучиваю ролики для туристических компаний и
          брендов.
        </p>
        <p class="mt-5 text-sm text-ed-muted">
          Видеопроизводство, монтаж, озвучка, съёмка путешествий.
        </p>
        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
          <a href="#contact" class="ed-cta">
            Обсудить проект
          </a>
          <button
            type="button"
            class="ed-link inline-flex min-h-11 items-center gap-2 text-sm"
            data-dialog-open="ed-reel"
            data-testid="showreel-open"
          >
            <Icon name="play" class="size-4" /> Смотреть шоурил
          </button>
        </div>
      </div>
      {/* Phone: the plate sits between name and standfirst and bleeds off the
          right edge, so the first screen holds the name, a picture and the pitch. */}
      <figure class="col-span-12 -mr-4 mt-8 max-lg:order-2 sm:col-span-9 sm:col-start-4 sm:mr-0 lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:-mr-8">
        <FootageFrame
          tone={{ from: '#24414f', to: '#d8d2bf', horizon: 60, sunX: 70, sunY: 30 }}
          ratio={null}
          class="aspect-[16/10] lg:aspect-[4/5]"
          description="Кадр из ролика о путешествии"
          placeholder={true}
          tag={false}
          eager
        />
        <figcaption class="mt-3 max-w-[46ch] text-sm text-ed-muted">
          Кадр из будущего ролика о путешествии.
          <PlaceholderTag detail="кадр" class={tagClass} />
        </figcaption>
      </figure>
    </section>

    <section id="showreel" class="border-t border-ed-line">
      <div class="mx-auto grid max-w-wide grid-cols-12 gap-x-6 gap-y-8 px-4 py-20 sm:px-8 lg:py-28">
        <div class="col-span-12 lg:col-span-3">
          <h2 class="font-ed-serif text-4xl font-light tracking-[-0.02em] sm:text-5xl">Шоурил</h2>
          <p class="mt-4 max-w-[34ch] text-ed-muted">
            Короткая сборка из разных проектов: путешествия, бренды, монтаж и голос.
          </p>
          <button
            type="button"
            class="ed-link mt-6 inline-flex min-h-11 items-center gap-2"
            data-dialog-open="ed-reel"
          >
            <Icon name="play" class="size-4" /> Смотреть
          </button>
        </div>
        <figure class="col-span-12 lg:col-span-8 lg:col-start-5">
          <div class="relative">
            <FootageFrame
              tone={{ from: '#2c3a33', to: '#c9c3a8' }}
              ratio="16 / 9"
              description="Обложка шоурила"
              tag={false}
            />
            <button
              type="button"
              class="absolute inset-0"
              data-dialog-open="ed-reel"
              aria-label="Смотреть шоурил"
            ></button>
          </div>
          <figcaption class="mt-3 text-sm text-ed-muted">
            Обложка шоурила. <PlaceholderTag detail="видео" class="text-ed-muted" />
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="work" class="border-t border-ed-line">
      <div
        class="mx-auto max-w-page px-4 py-20 sm:px-6 lg:px-8 lg:py-28"
        data-testid="page-container"
        data-filter-root
      >
        <div class="grid grid-cols-12 gap-x-6 gap-y-6">
          <h2 class="col-span-12 font-ed-serif text-4xl font-light tracking-[-0.02em] sm:text-5xl md:col-span-5">
            Указатель работ
          </h2>
          <div class="col-span-12 md:col-span-7 md:pt-4">
            <p class="mb-4 max-w-[52ch] text-sm leading-relaxed text-ed-ink" data-demo-note>
              {DEMO_WORK_NOTE}
            </p>
            <div class="flex flex-wrap gap-x-5 gap-y-1" role="group" aria-label="Фильтр работ">
              <button type="button" class="ed-filter" data-filter="all" aria-pressed="true">
                Все
              </button>
              {categories.map((c) => (
                <button type="button" class="ed-filter" data-filter={c.id} aria-pressed="false">
                  {c.label}
                </button>
              ))}
            </div>
            <p
              class="mt-2 text-sm text-ed-muted"
              data-filter-status
              data-template="Работ в указателе: {n}"
              aria-live="polite"
            >
              Работ в указателе: {projects.length}
            </p>
          </div>
        </div>

        <ul class="mt-12 border-b border-ed-line" data-project-list>
          {projects.map((p) => (
            <li data-category={p.category} class="border-t border-ed-line">
              <details class="ed-entry group" data-tone-from={p.tone.from} data-tone-to={p.tone.to}>
                <summary class="grid min-h-16 cursor-pointer list-none grid-cols-12 items-baseline gap-x-6 gap-y-1 py-5">
                  <span class="col-span-12 font-ed-serif text-2xl leading-tight sm:col-span-6 sm:text-3xl">
                    {p.title}
                  </span>
                  <span class="col-span-6 text-sm text-ed-muted sm:col-span-3">
                    {categoryLabel(p.category)}
                    {p.placeholder && (
                      <PlaceholderTag detail={DEMO_PROJECT_LABEL} class="mt-0.5 block text-xs" />
                    )}
                  </span>
                  <span class="col-span-6 flex items-baseline justify-end gap-3 text-sm text-ed-muted sm:col-span-3">
                    {p.place}
                    <span class="inline-block self-center transition-transform duration-300 group-open:rotate-45">
                      <Icon name="plus" class="size-4" />
                    </span>
                  </span>
                </summary>
                <div class="grid grid-cols-12 gap-x-6 gap-y-5 pb-10">
                  <FootageFrame
                    tone={p.tone}
                    ratio="16 / 9"
                    class="col-span-12 sm:col-span-7"
                    description={`Кадр из проекта «${p.title}»`}
                    placeholder={p.placeholder}
                    tag={false}
                  />
                  <div class="col-span-12 text-sm sm:col-span-5">
                    <h3 class="font-ed-serif text-lg">Что я делала</h3>
                    <p class="mt-1 text-ed-muted">{p.roles.map(serviceTitle).join(', ')}</p>
                    {p.placeholder && (
                      <p class="mt-4 max-w-[36ch] text-ed-muted">
                        Описание, кадры и видео появятся вместе с реальными работами.
                      </p>
                    )}
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ul>
        <div
          class="ed-preview pointer-events-none fixed top-0 left-0 z-30 hidden aspect-[4/3] w-72 opacity-0"
          aria-hidden="true"
          data-preview
        ></div>
      </div>
    </section>

    <section id="services" class="border-t border-ed-line bg-ed-tint">
      <div class="mx-auto max-w-wide px-4 py-20 sm:px-8 lg:py-28">
        <h2 class="font-ed-serif text-4xl font-light tracking-[-0.02em] sm:text-5xl">Услуги</h2>
        <dl class="mt-12">
          {services.map((s) => (
            <div class="grid grid-cols-12 gap-x-6 gap-y-3 border-t border-ed-line py-8">
              <dt class="col-span-12 font-ed-serif text-3xl font-light sm:text-4xl md:col-span-5">
                {s.displayTitle ?? s.title}
              </dt>
              <dd class="col-span-12 md:col-span-4 md:col-start-8">
                <p class="font-ed-serif text-lg leading-relaxed">{s.summary}</p>
                <p class="mt-2 text-sm text-ed-muted">{s.includes.join(', ')}</p>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="travel" class="border-t border-ed-line">
      <div class="mx-auto max-w-wide px-4 py-20 sm:px-8 lg:py-28">
        <div class="grid grid-cols-12 gap-x-6 gap-y-6">
          <h2 class="col-span-12 font-ed-serif text-4xl font-light tracking-[-0.02em] sm:text-5xl lg:col-span-5">
            Съёмка путешествий
          </h2>
          <p class="col-span-12 font-ed-serif text-2xl leading-snug font-light sm:text-3xl lg:col-span-6 lg:col-start-7">
            {travel.intro}
          </p>
        </div>

        <ol class="ed-route relative mt-16 grid gap-10 md:grid-cols-4 md:gap-6" data-route>
          {travel.steps.map((step, i) => (
            <li class="relative pl-10 md:pt-12 md:pl-0">
              <span class="ed-stop absolute top-1 left-0 md:top-0" aria-hidden="true" />
              <h3 class="font-ed-serif text-xl">
                <span class="mr-2 text-ed-water">{i + 1}</span>
                {step.title}
              </h3>
              <p class="mt-2 max-w-[30ch] text-ed-muted">{step.text}</p>
            </li>
          ))}
        </ol>

        <div class="mt-16 grid grid-cols-12 gap-x-6 gap-y-6">
          <figure class="col-span-12 lg:col-span-8">
            <FootageFrame
              tone={{ from: '#1f3b4d', to: '#b9cfd6' }}
              ratio="21 / 9"
              description="Кадр с выездной съёмки"
              tag={false}
            />
            <figcaption class="mt-3 text-sm text-ed-muted">
              Кадр с выезда. <PlaceholderTag detail="кадр" />
            </figcaption>
          </figure>
          <div class="col-span-12 lg:col-span-3 lg:col-start-10">
            <h3 class="font-ed-serif text-xl">Что получите</h3>
            <ul class="mt-3 space-y-2 text-ed-muted">
              {travel.formats.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="border-t border-ed-line">
      <div class="mx-auto grid max-w-wide grid-cols-12 gap-x-6 gap-y-10 px-4 py-20 sm:px-8 lg:py-28">
        <figure class="col-span-8 sm:col-span-5 lg:col-span-3 lg:col-start-2">
          <FootageFrame
            tone={{ from: '#3b3a35', to: '#cfc8b8' }}
            ratio="4 / 5"
            description="Портрет Анны"
            tag={false}
          />
          <figcaption class="mt-3 text-sm text-ed-muted">
            Анна на съёмке. <PlaceholderTag detail="фото" />
          </figcaption>
        </figure>
        <div class="col-span-12 lg:col-span-6 lg:col-start-6">
          <h2 class="font-ed-serif text-4xl font-light tracking-[-0.02em] sm:text-5xl">Обо мне</h2>
          <p class="mt-6 max-w-[58ch] font-ed-serif text-xl leading-relaxed">{person.bio}</p>
          {person.placeholderBio && (
            <PlaceholderTag detail="текст об Анне" class="mt-4 text-sm text-ed-muted" />
          )}
        </div>
      </div>
    </section>

    <section id="reviews" class="border-t border-ed-line">
      <div class="mx-auto max-w-wide px-4 py-20 sm:px-8 lg:py-28">
        <h2 class="font-ed-serif text-4xl font-light tracking-[-0.02em] sm:text-5xl">Отзывы</h2>
        <div class="mt-12 grid grid-cols-12 gap-x-6 gap-y-14">
          {testimonials.map((t, i) => (
            <figure
              class:list={[
                'col-span-12 md:col-span-6 lg:col-span-5',
                i === 1 && 'lg:col-start-7 lg:mt-24',
              ]}
            >
              <blockquote class="font-ed-serif text-2xl leading-snug font-light sm:text-3xl">
                «{t.quote}»
              </blockquote>
              <figcaption class="mt-5 text-sm text-ed-muted">
                {t.author}
                {t.company && `, ${t.company}`}
                {t.placeholder && <PlaceholderTag detail="реальный отзыв" class={tagClass} />}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="border-t border-ed-line bg-ed-tint">
      <div class="mx-auto grid max-w-wide grid-cols-12 gap-x-6 gap-y-10 px-4 pt-20 pb-10 sm:px-8 lg:pt-28">
        <div class="col-span-12 lg:col-span-6">
          <h2 class="font-ed-serif text-[clamp(3rem,12vw,6rem)] leading-[0.95] font-light tracking-[-0.035em]">
            Обсудить проект
          </h2>
          <p class="mt-6 max-w-[44ch] font-ed-serif text-xl leading-relaxed">
            Расскажите, что и где нужно снять. Отвечу, предложу план и сроки.
          </p>
        </div>
        <dl class="col-span-12 self-end lg:col-span-5 lg:col-start-8" data-contacts>
          {contacts.map((c) => (
            <div class="flex flex-wrap items-baseline justify-between gap-2 border-t border-ed-line py-4">
              <dt class="font-ed-serif text-xl">{c.label}</dt>
              <dd class="text-sm text-ed-muted">
                {c.href ? (
                  <a href={c.href} class="ed-link">
                    {c.value}
                  </a>
                ) : (
                  <PlaceholderTag detail="контакт появится" />
                )}
              </dd>
            </div>
          ))}
        </dl>
        <footer class="col-span-12 mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-ed-line pt-6 text-sm text-ed-muted">
          <a
            href={withBase('/design/')}
            class="inline-flex min-h-11 items-center gap-2 hover:text-ed-ink"
            data-testid="back-to-design"
          >
            <Icon name="back" class="size-4" /> Все концепции
          </a>
          <p>
            Концепция B. Набрано шрифтами Literata и Golos Text. Работы, отзывы и контакты —
            заглушки.
          </p>
        </footer>
      </div>
    </section>
  </main>

  <dialog
    id="ed-reel"
    data-dialog
    aria-label="Шоурил"
    class="ed-dialog m-auto w-[min(64rem,calc(100vw-2rem))] max-w-none bg-ed-paper p-0 text-ed-ink backdrop:bg-ed-ink/70"
  >
    <div class="flex items-center justify-between border-b border-ed-line px-5 py-3">
      <p class="font-ed-serif text-lg">Шоурил</p>
      <button
        type="button"
        class="-mr-3 grid size-11 place-items-center text-ed-muted hover:text-ed-ink"
        data-dialog-close
        aria-label="Закрыть шоурил"
      >
        <Icon name="close" />
      </button>
    </div>
    <div class="p-5">
      <FootageFrame
        tone={{ from: '#2c3a33', to: '#c9c3a8' }}
        ratio="16 / 9"
        description="Видео шоурила"
        tag={false}
      />
      <p class="mt-4 text-sm text-ed-muted">
        Здесь будет плеер со звуком. <PlaceholderTag detail="видео шоурила" />
      </p>
    </div>
  </dialog>
</div>

<script>
  import { initDialogs } from '../../../lib/ui/dialog';
  import { initFilters } from '../../../lib/ui/filter';
  import { initMenus } from '../../../lib/ui/menu';

  initMenus();
  initDialogs();
  initFilters();

  // Pointer-following preview for the index (desktop with a fine pointer only).
  const preview = document.querySelector<HTMLElement>('[data-preview]');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (preview && canHover) {
    preview.classList.remove('hidden');
    let frame = 0;
    document.querySelectorAll<HTMLDetailsElement>('.ed-entry').forEach((entry) => {
      const summary = entry.querySelector('summary');
      if (!summary) return;
      summary.addEventListener('pointerenter', () => {
        if (entry.open) return;
        preview.style.setProperty('--tone-from', entry.dataset.toneFrom ?? '#333');
        preview.style.setProperty('--tone-to', entry.dataset.toneTo ?? '#ccc');
        preview.dataset.visible = 'true';
      });
      summary.addEventListener('pointerleave', () => {
        preview.dataset.visible = 'false';
      });
      summary.addEventListener('pointermove', (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          preview.style.transform = `translate(${event.clientX + 24}px, ${event.clientY - 96}px)`;
        });
      });
      entry.addEventListener('toggle', () => {
        if (entry.open) preview.dataset.visible = 'false';
      });
    });
  }
</script>

<style is:global>
  html:has(.ed) {
    scrollbar-color: var(--color-ed-line) var(--color-ed-paper);
  }
  html[data-menu-open] {
    overflow: hidden;
  }
  .ed :focus-visible {
    outline-color: var(--color-ed-water);
  }
  .ed ::selection {
    background: var(--color-ed-water);
    color: var(--color-ed-paper);
  }

  .ed-link {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 0.2s ease-out;
  }
  .ed-link:hover {
    text-decoration-color: currentColor;
  }

  .ed-cta {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid currentColor;
    font-family: var(--font-ed-serif);
    font-size: 1.2rem;
    color: var(--color-ed-water);
  }
  .ed-cta:hover {
    color: var(--color-ed-ink);
  }

  .ed-filter {
    min-height: 2.75rem;
    min-width: 2.75rem;
    font-size: 0.95rem;
    color: var(--color-ed-muted);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.4em;
  }
  .ed-filter:hover {
    color: var(--color-ed-ink);
  }
  .ed-filter[aria-pressed='true'] {
    color: var(--color-ed-ink);
    text-decoration-color: var(--color-ed-water);
    text-decoration-thickness: 2px;
  }

  .ed-entry summary::-webkit-details-marker {
    display: none;
  }
  .ed-entry summary:hover span:first-child {
    color: var(--color-ed-water);
  }

  /* The route: a dotted line through the four stops. */
  .ed-route::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0.4375rem;
    border-left: 2px dotted var(--color-ed-water);
  }
  @media (min-width: 768px) {
    .ed-route::before {
      top: 0.4375rem;
      bottom: auto;
      left: 0.5rem;
      right: 0.5rem;
      border-left: 0;
      border-top: 2px dotted var(--color-ed-water);
    }
  }
  .ed-stop {
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--color-ed-paper);
    border: 2px solid var(--color-ed-water);
  }

  .ed-preview {
    background:
      radial-gradient(
        120% 70% at 72% 30%,
        color-mix(in oklab, var(--tone-to) 85%, white) 0%,
        transparent 45%
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklab, var(--tone-from) 70%, var(--tone-to)) 0%,
        var(--tone-to) 58%,
