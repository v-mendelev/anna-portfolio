---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import FontFaces from '../../components/ui/FontFaces.astro';
import { fontSets } from '../../site/fonts';
import { withBase } from '../../lib/paths';
import { demos, type DemoSlug } from '../../site/demos';
import { siteConfig } from '../../site/site.config';

/** Each card previews its concept in that concept's own type and colour. */
const swatch: Record<DemoSlug, { panel: string; word: string; label: string }> = {
  cinematic: {
    panel: 'bg-cine-void text-cine-screen',
    word: 'font-cine-display text-5xl font-light italic',
    label: 'Тёмный зал, видео на первом плане',
  },
  editorial: {
    panel: 'bg-ed-paper text-ed-ink',
    word: 'font-ed-serif text-5xl font-light tracking-[-0.03em]',
    label: 'Светлый журнальный разворот',
  },
  creative: {
    panel: 'bg-cr-yellow text-cr-ink',
    word: 'font-cr-display text-3xl font-black uppercase -rotate-6',
    label: 'Плакат, диагонали и движение',
  },
};
---

<BaseLayout title="Выбор демоверсии">
  <FontFaces slot="head" set={fontSets.chooser} />
  <Container as="main" id="main" class="py-12 sm:py-20" data-testid="page-container">
    <p class="text-sm text-ink-muted">{siteConfig.name}</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-balance sm:text-5xl">
      Выберите демоверсию дизайна
    </h1>
    <p class="mt-4 max-w-prose text-base text-ink-muted sm:text-lg">
      Три направления одного сайта-портфолио с одинаковым содержанием. Работы, отзывы и контакты
      пока заглушки.
    </p>
    <ul class="mt-10 grid gap-6 md:grid-cols-3" data-testid="demo-list">
      {demos.map((demo) => (
        <li>
          <a
            href={withBase(`/design/${demo.slug}/`)}
            data-testid={`demo-link-${demo.slug}`}
            class="group block h-full overflow-hidden rounded-xl border border-line bg-surface-raised transition-colors hover:border-ink"
          >
            <span class:list={['grid aspect-[4/3] place-items-center', swatch[demo.slug].panel]}>
              <span class={swatch[demo.slug].word}>{demo.title}</span>
            </span>
            <span class="block p-5">
              <span class="block text-lg font-semibold">{swatch[demo.slug].label}</span>
              <span class="mt-2 block text-sm leading-relaxed text-ink-muted">{demo.summary}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</BaseLayout>
