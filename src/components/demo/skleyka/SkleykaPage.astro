---
/**
 * Concept B — SKLEYKA ("склейка", the splice): editorial disruption.
 * A white magazine in black condensed capitals; electric blue is the editor's
 * layer only: the shifted halves of cut headlines, splice lines, the marks
 * that show what Anna does on a project, and active states.
 * Signatures:
 *  - cut headlines that land as you scroll (one scroll-driven animation,
 *    transform only; static fallback stays readable);
 *  - project spreads on black "plates" with in/out clip marks;
 *  - role annotations: the services a project needs are circled in blue.
 */
import FootageFrame from '../../ui/FootageFrame.astro';
import Icon from '../../ui/Icon.astro';
import PlaceholderTag from '../../ui/PlaceholderTag.astro';
import CutLine from './CutLine.astro';
import { withBase } from '../../../lib/paths';
import { usedCategories } from '../../../lib/portfolio';
import {
  DEMO_PROJECT_LABEL,
  DEMO_WORK_NOTE,
  HERO,
  SECTIONS,
  TRAVEL_HEADING,
  categoryLabel,
  content,
  serviceTitle,
} from '../../../site/content';

const { person, services, projects, travel, testimonials, contacts } = content;
const categories = usedCategories(content.categories, projects);
const plateTag = 'absolute bottom-3 left-3 bg-paper px-2 py-0.5 text-xs font-semibold text-pitch';
---

<div class="sk min-h-dvh bg-paper font-sk-text text-pitch" data-concept="editorial">
  <header class="sticky top-0 z-40 border-b-2 border-pitch bg-paper" data-site-header>
    <div class="sk-wrap flex h-14 items-center justify-between gap-6">
      <a href="#top" class="sk-tap font-sk-display text-2xl leading-none font-extrabold uppercase">
        {person.name}
      </a>
      <nav aria-label="Разделы" class="hidden items-center lg:flex">
        {SECTIONS.map((s) => (
          <a href={`#${s.id}`} class="sk-link">
            {s.label}
          </a>
        ))}
      </nav>
      <button
        type="button"
        class="sk-tap gap-2 px-1 text-sm font-bold lg:hidden"
        data-menu-toggle
        aria-controls="sk-menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="size-5" />
        Содержание
      </button>
    </div>
  </header>

  <div
    id="sk-menu"
    class="fixed inset-0 z-50 overflow-y-auto bg-paper"
    role="dialog"
    aria-modal="true"
    aria-label="Содержание"
    data-menu-modal
    hidden
  >
    <div class="sk-wrap flex h-14 items-center justify-between border-b-2 border-pitch">
      <span class="font-sk-display text-2xl font-extrabold uppercase">Содержание</span>
      <button
        type="button"
        class="-mr-2.5 grid size-11 place-items-center"
        data-menu-close
        aria-label="Закрыть меню"
      >
        <Icon name="close" />
      </button>
    </div>
    <nav aria-label="Содержание" class="sk-wrap py-4">
      <ul>
        {SECTIONS.map((s) => (
          <li class="border-b border-pitch">
            <a
              href={`#${s.id}`}
              class="flex min-h-16 items-center font-sk-display text-[clamp(2.75rem,13vw,5rem)] leading-none font-extrabold uppercase"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={withBase('/design/')} class="sk-tap mt-6 gap-2 text-sm font-semibold">
        <Icon name="back" class="size-4" /> Все концепции
      </a>
    </nav>
  </div>

  <main id="main">
    <section id="top" class="sk-hero">
      <div class="sk-wrap grid grid-cols-12 gap-x-4 pt-6 pb-14 lg:gap-x-6 lg:pt-10 lg:pb-24">
        <h1 class="sk-name col-span-12 font-sk-display font-extrabold uppercase">
          <CutLine text="Анна" shift="-0.05em" class="ml-auto sk-name-short" />{' '}
          <CutLine text="Шеленкова" shift="-0.06em" class="sk-hero-cut ml-[0.06em]" />
        </h1>
        <div class="col-span-12 mt-6 sm:col-span-7 lg:col-span-4 lg:mt-12">
          <p class="max-w-[30ch] text-lg leading-snug font-semibold lg:text-xl">{HERO.lead}</p>
          <p class="mt-3 text-sm font-medium">{HERO.next}</p>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
            <a href="#contact" class="sk-cta">
              Обсудить проект
            </a>
            <button
              type="button"
              class="sk-tap gap-2 text-sm font-bold underline decoration-volt decoration-2 underline-offset-4"
              data-dialog-open="sk-reel"
              data-testid="showreel-open"
            >
              <Icon name="play" class="size-4" /> Смотреть шоурил
            </button>
          </div>
        </div>
        {/* The reel sits on the opposite corner, bracketed by in/out marks. */}
        <div class="relative col-span-11 col-start-2 mt-10 sm:col-span-5 sm:col-start-8 lg:col-span-6 lg:col-start-7 lg:mt-12">
          <span class="sk-inout" aria-hidden="true"></span>
          <FootageFrame
            tone={{ from: '#000000', to: '#1a2bff' }}
            paint="none"
            ratio="16 / 9"
            class="sk-plate"
            description="Кадр из шоурила"
            placeholderDetail="кадр шоурила"
            tagClass={plateTag}
            eager
          >
            <span class="sk-splice" aria-hidden="true"></span>
          </FootageFrame>
          <button
            type="button"
            class="absolute inset-0"
            data-dialog-open="sk-reel"
            aria-label="Смотреть шоурил"
          ></button>
        </div>
      </div>
    </section>

    <section id="showreel" class="border-t-2 border-pitch">
      <div class="sk-wrap grid grid-cols-12 gap-x-4 gap-y-8 py-16 lg:gap-x-6 lg:py-24">
        <h2 class="sk-h2 col-span-12 lg:col-span-5">
          <CutLine text="Шоурил" />
        </h2>
        <div class="col-span-12 lg:col-span-6 lg:col-start-7 lg:pt-6">
          <p class="max-w-[38ch] text-lg leading-relaxed">
            Короткая сборка из разных проектов: съёмка, монтаж и голос.
          </p>
          <button
            type="button"
            class="sk-tap mt-4 gap-2 font-bold underline decoration-volt decoration-2 underline-offset-4"
            data-dialog-open="sk-reel"
          >
            <Icon name="play" class="size-4" /> Смотреть
          </button>
          <p class="mt-3 text-sm font-medium">
            <PlaceholderTag detail="видео появится позже" />
          </p>
        </div>
      </div>
    </section>

    <section id="work" class="border-t-2 border-pitch">
      <div class="sk-wrap py-16 lg:py-24" data-testid="page-container" data-filter-root>
        <div class="grid grid-cols-12 gap-x-4 gap-y-6 lg:gap-x-6">
          <h2 class="sk-h2 col-span-12 lg:col-span-6">
            <CutLine text="Работы" shift="-0.14em" />
          </h2>
          <div class="col-span-12 lg:col-span-5 lg:col-start-8 lg:pt-4">
            <p class="max-w-[48ch] text-base leading-relaxed font-medium" data-demo-note>
              {DEMO_WORK_NOTE}
            </p>
            <div class="mt-4 flex flex-wrap gap-x-5" role="group" aria-label="Фильтр работ">
              <button type="button" class="sk-filter" data-filter="all" aria-pressed="true">
                Все
              </button>
              {categories.map((c) => (
                <button type="button" class="sk-filter" data-filter={c.id} aria-pressed="false">
                  {c.label}
                </button>
              ))}
            </div>
            <p
              class="mt-1 text-sm font-medium"
              data-filter-status
              data-template="Разворотов: {n}"
              aria-live="polite"
            >
              Разворотов: {projects.length}
            </p>
          </div>
        </div>

        <ol class="mt-14 space-y-16 lg:space-y-24" data-project-list>
          {projects.map((p, i) => (
            <li data-category={p.category}>
              <article class="grid grid-cols-12 gap-x-4 lg:gap-x-6">
                <div
                  class:list={[
                    'relative col-span-12 lg:col-span-7',
                    i % 2 ? 'lg:col-start-6' : 'lg:col-start-1',
                  ]}
                >
                  <span class="sk-inout" aria-hidden="true"></span>
                  <FootageFrame
                    tone={p.tone}
                    paint="none"
                    ratio="3 / 2"
                    class="sk-plate"
                    description={`Кадр из проекта «${p.title}»`}
                    placeholder={p.placeholder}
                    placeholderDetail={DEMO_PROJECT_LABEL}
                    tagClass={plateTag}
                  >
                    <span class="sk-splice" aria-hidden="true"></span>
                  </FootageFrame>
                </div>
                <div
                  class:list={[
                    'col-span-12 lg:col-span-4 lg:row-start-1 lg:self-center',
                    i % 2 ? 'lg:col-start-1' : 'lg:col-start-9',
                  ]}
                >
                  <h3 class="sk-spread-title font-sk-display font-extrabold uppercase">
                    {p.title}
                  </h3>
                  <p class="mt-2 text-sm font-medium">
                    {categoryLabel(p.category)}
                    {p.place && <span>, {p.place.toLowerCase()}</span>}
                  </p>
                  <p class="mt-5 text-sm font-semibold">Что я делаю в таком проекте</p>
                  <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
                    {p.roles.map((r) => (
                      <li class="sk-mark text-lg font-bold">{serviceTitle(r)}</li>
                    ))}
                  </ul>
                </div>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="services" class="border-t-2 border-pitch">
      <div class="sk-wrap py-16 lg:py-24">
        <h2 class="sk-h2">
          <CutLine text="Услуги" shift="0.16em" />
        </h2>
        <p class="mt-4 max-w-[40ch] text-lg">Можно заказать всё вместе или одну часть работы.</p>
        <dl class="mt-12">
          {services.map((s) => (
            <div class="grid grid-cols-12 gap-x-4 gap-y-3 border-t-2 border-pitch py-7 lg:gap-x-6">
              <dt class="col-span-12 min-w-0 font-sk-display text-[clamp(2.25rem,11.4vw,6.5rem)] leading-[0.82] lg:text-[min(5.6vw,5.5rem)] font-extrabold uppercase lg:col-span-6">
                {s.title}
              </dt>
              <dd class="col-span-12 lg:col-span-5 lg:col-start-8">
                <p class="text-lg leading-snug font-semibold">{s.summary}</p>
                <p class="mt-2 text-sm leading-relaxed">{s.includes.join(', ')}</p>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="travel" class="border-t-2 border-pitch">
      <div class="sk-wrap py-16 lg:py-24">
        <div class="grid grid-cols-12 gap-x-4 gap-y-6 lg:gap-x-6">
          <h2 class="sk-h2 col-span-12 lg:col-span-7">
            <CutLine text={TRAVEL_HEADING.main} shift="-0.12em" />
            <span class="mt-3 block font-sk-text text-[clamp(1.25rem,5vw,2rem)] leading-none font-bold tracking-[-0.02em] normal-case">
              {TRAVEL_HEADING.sub}
            </span>
          </h2>
          <p class="col-span-12 max-w-[40ch] text-xl leading-snug font-semibold lg:col-span-5 lg:pt-6">
            {travel.intro}
          </p>
        </div>
        {/* An edit timeline: four steps in order, separated by splices. */}
        <ol class="sk-steps mt-14 grid gap-y-8 md:grid-cols-4">
          {travel.steps.map((step, i) => (
            <li class="sk-step">
              <span class="font-sk-display text-6xl leading-none font-extrabold text-volt">
                {i + 1}
              </span>
              <h3 class="mt-2 text-lg font-bold">{step.title}</h3>
              <p class="mt-1 max-w-[30ch] text-sm leading-relaxed">{step.text}</p>
            </li>
          ))}
        </ol>
        <h3 class="mt-12 text-sm font-bold">Что получите</h3>
        <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-lg font-semibold">
          {travel.formats.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="about" class="border-t-2 border-pitch">
      <div class="sk-wrap grid grid-cols-12 items-end gap-x-4 gap-y-8 py-16 lg:gap-x-6 lg:py-24">
        <div class="relative col-span-8 sm:col-span-5 lg:col-span-4">
          <span class="sk-inout" aria-hidden="true"></span>
          <FootageFrame
            tone={{ from: '#000000', to: '#1a2bff' }}
            paint="none"
            ratio="4 / 5"
            class="sk-plate"
            description="Портрет Анны"
            placeholderDetail="фото Анны"
            tagClass={plateTag}
          />
        </div>
        <div class="col-span-12 lg:col-span-7 lg:col-start-6">
          <h2 class="sk-h2">
            <CutLine text="Обо мне" />
          </h2>
          <p class="mt-6 max-w-[54ch] text-xl leading-relaxed">{person.bio}</p>
          {person.placeholderBio && (
            <PlaceholderTag detail="текст об Анне" class="mt-4 text-sm font-semibold" />
          )}
        </div>
      </div>
    </section>

    <section id="reviews" class="border-t-2 border-pitch">
      <div class="sk-wrap py-16 lg:py-24">
        <h2 class="sk-h2">
          <CutLine text="Отзывы" shift="-0.14em" />
        </h2>
        <div class="mt-12 grid grid-cols-12 gap-x-4 gap-y-12 lg:gap-x-6">
          {testimonials.map((t, i) => (
            <figure
              class:list={['col-span-12 lg:col-span-5', i === 1 && 'lg:col-start-8 lg:mt-28']}
            >
              <blockquote class="text-[clamp(1.375rem,4.5vw,2rem)] leading-tight font-bold tracking-[-0.015em]">
                «{t.quote}»
              </blockquote>
              <figcaption class="mt-4 text-sm font-semibold">
                {t.author}
                {t.company && `, ${t.company}`}
                {t.placeholder && <PlaceholderTag detail="реальный отзыв" class="mt-1 block" />}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="border-t-2 border-pitch">
      <div class="sk-wrap pt-16 pb-10 lg:pt-24">
        <h2 class="sk-h2 sk-h2--xl">
          <CutLine text="Обсудить" shift="0.12em" />{' '}
          <CutLine text="проект" shift="-0.12em" class="sk-indent" />
        </h2>
        <p class="mt-6 max-w-[40ch] text-xl leading-snug font-semibold">
          Расскажите, что и где нужно снять. Отвечу, предложу план и сроки.
        </p>
        {/* Contacts on a black plate, with the splice running through it. */}
        <dl
          class="sk-contact-plate relative mt-12 grid gap-x-6 bg-pitch px-5 pt-4 pb-6 text-paper sm:grid-cols-3 sm:px-8"
          data-contacts
        >
          {contacts.map((c) => (
            <div class="border-t-2 border-paper py-4">
              <dt class="font-sk-display text-4xl leading-none font-extrabold uppercase">
                {c.label}
              </dt>
              <dd class="mt-2 text-sm font-semibold">
                {c.href ? (
                  <a href={c.href}>{c.value}</a>
                ) : (
                  <PlaceholderTag detail="контакт появится" />
                )}
              </dd>
            </div>
          ))}
        </dl>
        <footer class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t-2 border-pitch pt-4 text-sm font-semibold">
          <a href={withBase('/design/')} class="sk-tap gap-2" data-testid="back-to-design">
            <Icon name="back" class="size-4" /> Все концепции
          </a>
          <p>Концепция «Склейка». Работы, отзывы и контакты — заглушки.</p>
        </footer>
      </div>
    </section>
  </main>

  <dialog
    id="sk-reel"
    data-dialog
    aria-label="Шоурил"
    class="m-auto w-[min(70rem,calc(100vw-2rem))] max-w-none bg-paper p-0 text-pitch backdrop:bg-pitch/80"
  >
    <div class="flex h-14 items-center justify-between border-b-2 border-pitch px-4">
      <p class="font-sk-display text-2xl font-extrabold uppercase">Шоурил</p>
      <button
        type="button"
        class="-mr-2.5 grid size-11 place-items-center"
        data-dialog-close
        aria-label="Закрыть шоурил"
      >
        <Icon name="close" />
      </button>
    </div>
    <div class="p-4 sm:p-6">
      <FootageFrame
        tone={{ from: '#000000', to: '#1a2bff' }}
        paint="none"
        ratio="16 / 9"
        class="sk-plate"
        description="Видео шоурила"
        placeholderDetail="видео шоурила"
        tagClass={plateTag}
      >
        <span class="sk-splice" aria-hidden="true"></span>
      </FootageFrame>
      <p class="mt-4 text-sm font-semibold">Здесь будет плеер со звуком, когда появится шоурил.</p>
    </div>
  </dialog>
</div>

<script>
  import { initDialogs } from '../../../lib/ui/dialog';
  import { initFilters } from '../../../lib/ui/filter';
  import { initMenus } from '../../../lib/ui/menu';

  initMenus();
  initDialogs();
  initFilters();
</script>

<style is:global>
  html:has(.sk) {
    scrollbar-color: var(--color-pitch) var(--color-paper);
  }
  html[data-menu-open] {
    overflow: hidden;
  }
  .sk :focus-visible {
    outline: 3px solid var(--color-volt);
    outline-offset: 3px;
  }
  .sk ::selection {
    background: var(--color-volt);
    color: var(--color-paper);
  }

  .sk-wrap {
    margin-inline: auto;
    max-width: var(--container-wide);
    padding-inline: 1rem;
  }
  @media (min-width: 64rem) {
    .sk-wrap {
      padding-inline: 2rem;
    }
  }
  /* In the components layer so responsive utilities (lg:hidden) still win. */
  @layer components {
    .sk-tap {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
    }
  }
  .sk-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0 0.6rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }
  .sk-link:hover {
    text-decoration-color: var(--color-volt);
  }

  /* Display sizes. Each cut line is a single word on one line (nowrap), sized
     with the viewport so it always fits its column. */
  .sk-name {
    font-size: clamp(4rem, 22.6vw, 20.5rem);
    line-height: 0.8;
  }
  .sk-name-short {
    font-size: 0.74em;
  }
  .sk-h2 {
    font-family: var(--font-sk-display);
    font-size: clamp(3.75rem, 17vw, 12rem);
    font-weight: 800;
    line-height: 0.8;
    text-transform: uppercase;
  }
  .sk-h2--xl {
    font-size: clamp(4rem, 21vw, 16rem);
  }
  @media (min-width: 64rem) {
    .sk-h2 {
      font-size: min(11vw, 11rem);
    }
    .sk-h2--xl {
      font-size: min(15vw, 15rem);
    }
  }
  .sk-indent {
    margin-left: 0.35em;
  }
  .sk-spread-title {
    font-size: clamp(2.5rem, 10vw, 4.25rem);
    line-height: 0.86;
  }

  /* The cut. --cut-at is where the splice runs, measured from the top of the
     line box (just under the middle of the capitals). */
  .sk-cut {
    --cut-at: 50%;
    position: relative;
    display: block;
    width: fit-content;
    max-width: 100%;
    white-space: nowrap;
  }
  .sk-cut-a {
    display: block;
    clip-path: inset(0 0 calc(100% - var(--cut-at)) 0);
  }
  .sk-cut-b {
    position: absolute;
    inset: 0;
    color: var(--color-volt);
    clip-path: inset(var(--cut-at) 0 0 0);
    transform: translateX(var(--cut-shift));
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Longhands on purpose: the minifier folds a shorthand + animation-timeline
         into one invalid shorthand and the scroll animation silently dies. */
      .sk-cut-b {
        animation-name: sk-land;
        animation-timing-function: cubic-bezier(0.3, 0, 0.2, 1);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 15% cover 42%;
      }
      /* The hero is already in view on load: its cut lands over the first
         stretch of page scroll instead. */
      .sk-hero .sk-cut-b {
        animation-timeline: scroll(root);
        animation-range: 0 45vh;
      }
      @keyframes sk-land {
        to {
          transform: translateX(0);
        }
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sk-cut-b {
      transform: none;
    }
  }

  .sk-cta {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    background: var(--color-pitch);
    padding: 0 1.25rem;
    font-weight: 800;
    color: var(--color-paper);
    transition: background-color 0.2s ease-out;
  }
  .sk-cta:hover {
    background: var(--color-volt);
  }

  .sk-filter {
    min-height: 2.75rem;
    min-width: 2.75rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.35em;
  }
  .sk-filter[aria-pressed='true'] {
    text-decoration-color: var(--color-volt);
  }

  /* Plates: black frames with the splice line that marks a cut. */
  .sk-plate {
    background: var(--color-pitch);
  }
  .sk-splice {
    position: absolute;
    left: 0;
    right: 0;
    top: 58%;
    height: 3px;
    background: var(--color-volt);
  }
  /* In/out marks: the editor's brackets for where a clip starts and ends. */
  .sk-inout {
    --len: clamp(1rem, 3vw, 1.75rem);
    position: absolute;
    inset: -0.6rem;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(var(--color-volt), var(--color-volt)) left top / var(--len) 3px no-repeat,
      linear-gradient(var(--color-volt), var(--color-volt)) left top / 3px var(--len) no-repeat,
