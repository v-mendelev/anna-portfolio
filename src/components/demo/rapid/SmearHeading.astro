---
/**
 * RAPID section heading with a motion trail: two aria-hidden "ghost" copies
 * sit behind the word and converge onto it as the heading enters the view
 * (CSS scroll-driven animation, transform + opacity only). Without scroll-driven
 * animation support, or with reduced motion, the ghosts are simply not shown.
 */
interface Props {
  text: string;
  as?: 'h1' | 'h2';
  /** Width for this word as font-stretch percent (62.5–100). */
  width?: number;
  class?: string;
  /** Extra inline style, e.g. a per-heading size custom property. */
  style?: string;
}
const { text, as: Tag = 'h2', width = 62.5, class: className, style = '' } = Astro.props;
const family = width <= 75 ? 'var(--font-rp-condensed)' : 'var(--font-rp)';
---

<Tag
  class:list={['rp-smear', className]}
  style={`font-stretch: ${width}%; font-family: ${family}; ${style}`}
>
  <span class="rp-smear-ghost rp-smear-ghost--far" aria-hidden="true">
    {text}
  </span>
  <span class="rp-smear-ghost" aria-hidden="true">
    {text}
  </span>
  <span class="rp-smear-text">{text}</span>
  <slot />
</Tag>
