---
/** About Anna: her portrait in viewfinder marks and a short bio. */
import FootageFrame from '../../components/ui/FootageFrame.astro';
import PlaceholderTag from '../../components/ui/PlaceholderTag.astro';
import { content } from '../content';

const { person } = content;
---

<section id="about" class="border-t-2 border-volt">
  <div class="kadr-wrap grid items-start gap-x-6 gap-y-10 py-16 lg:grid-cols-12 lg:py-24">
    {/* The portrait keeps its original 2:3 ratio: nothing is cropped. */}
    <div class="kadr-frame relative w-2/3 max-w-[22rem] lg:col-span-4 lg:w-auto lg:max-w-none">
      <span class="vf" aria-hidden="true"></span>
      <FootageFrame
        paint="none"
        ratio="2 / 3"
        class="kadr-slate"
        description={person.portraitAlt ?? `Портрет: ${person.name}`}
        poster={person.portrait}
        posterAvif={person.portraitAvif}
        placeholderDetail="фото Анны"
        tagClass="absolute bottom-2 left-2 bg-paper px-1.5 py-0.5 text-xs font-semibold"
      />
    </div>
    <div class="lg:col-span-7 lg:col-start-6">
      <h2 class="kadr-h2">Обо мне</h2>
      <div class="mt-6 max-w-[34em] space-y-4 text-lg leading-relaxed font-semibold" data-bio>
        {person.bio.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      {person.placeholderBio && (
        <PlaceholderTag detail="текст об Анне" class="mt-4 text-sm font-semibold" />
      )}
    </div>
  </div>
</section>
