---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CreativePage from '../../../components/demo/creative/CreativePage.astro';
import FontFaces from '../../../components/ui/FontFaces.astro';
import { getDemo } from '../../../site/get-demo';
import { fontSets } from '../../../site/fonts';

const demo = getDemo('creative');
---

<BaseLayout
  title={`Демо: ${demo.title}`}
  bodyClass="bg-cr-ivory text-cr-plum"
  themeColor="#f6f0e8"
  skipLinkClass="bg-cr-plum text-cr-ivory focus-visible:outline-cr-plum"
>
  <FontFaces slot="head" set={fontSets.creative} />
  <CreativePage />
</BaseLayout>
