---
/**
 * Concept A — KADR ("кадр", the frame): a viewfinder attention grid.
 * The camera's framing aids are the layout: rule-of-thirds guides, corner
 * marks and safe-area margins (env(safe-area-inset-*)). Everything is set in
 * electric blue on white in one heavy grotesk (Onest).
 * Signatures:
 *  - the hero is composed on visible thirds; the name fills the top band;
 *  - corner marks "pull focus" (tighten) on the frame you point at;
 *  - the portfolio is a contact sheet: tap a frame to blow it up in place
 *    (View Transitions when available; instant otherwise).
 */
import FootageFrame from '../../ui/FootageFrame.astro';
import Icon from '../../ui/Icon.astro';
import PlaceholderTag from '../../ui/PlaceholderTag.astro';
import { withBase } from '../../../lib/paths';
import { usedCategories } from '../../../lib/portfolio';
import {
  DEMO_PROJECT_LABEL,
  DEMO_WORK_NOTE,
  HERO,
  SECTIONS,
  TRAVEL_HEADING,
  categoryLabel,
  content,
  serviceTitle,
} from '../../../site/content';

const { person, services, projects, travel, testimonials, contacts } = content;
const categories = usedCategories(content.categories, projects);
const navLinks = SECTIONS.filter((s) => ['work', 'services', 'travel', 'contact'].includes(s.id));
const frameNo = (i: number) => String(i + 1).padStart(2, '0');
const tag = 'absolute bottom-2 left-2 bg-paper px-1.5 py-0.5 text-xs font-semibold text-volt';
---

<div class="kadr min-h-dvh bg-paper font-kadr text-volt-deep" data-concept="cinematic">
  <header class="sticky top-0 z-40 border-b-2 border-volt bg-paper" data-site-header>
    <div class="kadr-wrap flex h-14 items-center justify-between gap-6">
      <a href="#top" class="kadr-tap text-base font-extrabold tracking-[-0.02em]">
        {person.name}
      </a>
      <nav aria-label="Разделы" class="hidden items-center gap-1 lg:flex">
        {navLinks.map((s) => (
          <a href={`#${s.id}`} class="kadr-link">
            {s.label}
          </a>
        ))}
      </nav>
      <button
        type="button"
        class="kadr-tap gap-2 px-1 text-sm font-bold lg:hidden"
        data-menu-toggle
        aria-controls="kadr-menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="size-5" />
        Меню
      </button>
    </div>
  </header>

  <div
    id="kadr-menu"
    class="fixed inset-0 z-50 overflow-y-auto bg-paper"
    role="dialog"
    aria-modal="true"
    aria-label="Меню"
    data-menu-modal
    hidden
  >
    <div class="kadr-wrap flex h-14 items-center justify-between border-b-2 border-volt">
      <span class="font-extrabold">{person.name}</span>
      <button
        type="button"
        class="-mr-2.5 grid size-11 place-items-center"
        data-menu-close
        aria-label="Закрыть меню"
      >
        <Icon name="close" />
      </button>
    </div>
    <nav aria-label="Меню" class="kadr-wrap py-6">
      <ul>
        {SECTIONS.map((s) => (
          <li class="border-b border-volt-tint">
            <a
              href={`#${s.id}`}
              class="flex min-h-14 items-center text-[clamp(2rem,9vw,3.5rem)] leading-none font-black tracking-[-0.04em]"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={withBase('/design/')} class="kadr-tap mt-8 gap-2 text-sm font-semibold">
        <Icon name="back" class="size-4" /> Все концепции
      </a>
    </nav>
  </div>

  <main id="main">
    {/* Hero: composed on the thirds. Name = top band, frame = middle band,
        pitch and actions = bottom band. Guides are drawn behind everything. */}
    <section id="top" class="kadr-hero relative overflow-hidden">
      <div class="kadr-wrap relative grid grid-cols-6 gap-x-4 pt-5 pb-14 lg:grid-cols-12 lg:gap-x-6 lg:pt-8 lg:pb-20">
        <div class="kadr-guides" aria-hidden="true"></div>
        <h1 class="kadr-name col-span-6 uppercase max-lg:order-1 lg:col-span-12">
          <span class="block lg:pl-[var(--third)]">Анна</span>
          <span class="block">Шеленкова</span>
        </h1>
        {/* Phone: pitch and actions come before the frame so the contact action
            is on the first screen even on short phones; desktop keeps the thirds. */}
        <div class="relative col-span-6 mt-8 max-lg:order-3 lg:col-span-8 lg:col-start-5 lg:row-span-2 lg:mt-10">
          <span class="vf" aria-hidden="true"></span>
          <FootageFrame
            tone={{ from: '#0b16a8', to: '#e6e8ff' }}
            paint="none"
            ratio="16 / 9"
            class="kadr-slate"
            description="Кадр из шоурила"
            placeholderDetail="кадр шоурила"
            tagClass={tag}
            eager
          >
            <span class="kadr-slate-mark" aria-hidden="true">
              <Icon name="play" class="size-7 lg:size-10" />
            </span>
          </FootageFrame>
          <button
            type="button"
            class="absolute inset-0"
            data-dialog-open="kadr-reel"
            aria-label="Смотреть шоурил"
          ></button>
        </div>
        <div class="col-span-6 mt-6 max-lg:order-2 lg:col-span-4 lg:col-start-1 lg:row-start-2 lg:mt-10 lg:self-end">
          <p class="max-w-[18em] text-xl leading-snug font-semibold tracking-[-0.01em] lg:text-2xl">
            {HERO.lead}
          </p>
          <p class="mt-3 text-sm font-medium">{HERO.next}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="#contact" class="kadr-btn kadr-btn--solid">
              Обсудить проект
            </a>
            <button
              type="button"
              class="kadr-btn"
              data-dialog-open="kadr-reel"
              data-testid="showreel-open"
            >
              <Icon name="play" class="size-4" /> Смотреть шоурил
            </button>
          </div>
        </div>
      </div>
    </section>

    <section id="showreel" class="border-t-2 border-volt">
      <div class="kadr-wrap grid gap-x-6 gap-y-8 py-16 lg:grid-cols-12 lg:py-24">
        <div class="lg:col-span-5">
          <h2 class="kadr-h2">Шоурил</h2>
          <p class="mt-5 max-w-[20em] text-lg leading-relaxed font-medium">
            Лучшие кадры из разных проектов в одном ролике: съёмка, монтаж и голос.
          </p>
          <p class="mt-3 text-sm font-semibold">
            <PlaceholderTag detail="видео появится позже" />
          </p>
        </div>
        <div class="relative lg:col-span-7">
          <span class="vf" aria-hidden="true"></span>
          <FootageFrame
            tone={{ from: '#0b16a8', to: '#e6e8ff' }}
            paint="none"
            ratio="2.39 / 1"
            class="kadr-slate"
            description="Обложка шоурила"
            tag={false}
          >
            <span class="kadr-slate-mark" aria-hidden="true">
              <Icon name="play" class="size-8 lg:size-12" />
            </span>
          </FootageFrame>
          <button
            type="button"
            class="absolute inset-0"
            data-dialog-open="kadr-reel"
            aria-label="Смотреть шоурил"
          ></button>
        </div>
      </div>
    </section>

    <section id="work" class="border-t-2 border-volt">
      <div class="kadr-wrap py-16 lg:py-24" data-testid="page-container" data-filter-root>
        <div class="grid gap-x-6 gap-y-5 lg:grid-cols-12">
          <h2 class="kadr-h2 lg:col-span-5">Работы</h2>
          <div class="lg:col-span-7 lg:pt-3">
            <p class="max-w-[31em] text-base leading-relaxed font-medium" data-demo-note>
              {DEMO_WORK_NOTE}
            </p>
            <div class="mt-4 -ml-3 flex flex-wrap gap-x-1" role="group" aria-label="Фильтр работ">
              <button type="button" class="kadr-filter" data-filter="all" aria-pressed="true">
                Все
              </button>
              {categories.map((c) => (
                <button type="button" class="kadr-filter" data-filter={c.id} aria-pressed="false">
                  {c.label}
                </button>
              ))}
            </div>
            <p
              class="mt-3 text-sm font-semibold"
              data-filter-status
              data-template="Кадров на листе: {n}"
              aria-live="polite"
            >
              Кадров на листе: {projects.length}
            </p>
          </div>
        </div>

        {/* Contact sheet: frames numbered like a real sheet (their order on the
            roll). A frame opens in place to full width with what Anna would do. */}
        <ol
          class="kadr-sheet mt-12 grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-3 lg:gap-x-8"
          data-project-list
        >
          {projects.map((p, i) => (
            <li
              data-category={p.category}
              class="kadr-cell"
              style={`view-transition-name: kadr-cell-${p.id}`}
            >
              <article class="relative">
                <div class="relative">
                  <span class="vf" aria-hidden="true"></span>
                  <FootageFrame
                    tone={p.tone}
                    paint="none"
                    ratio={null}
                    class="kadr-slate kadr-cell-frame"
                    description={`Кадр из проекта «${p.title}»`}
                    placeholder={p.placeholder}
                    tag={false}
                  >
                    <span class="kadr-frame-no" aria-hidden="true">
                      {frameNo(i)}
                    </span>
                  </FootageFrame>
                </div>
                <h3 class="mt-3 text-base leading-tight font-extrabold tracking-[-0.01em] lg:text-xl">
                  {p.title}
                </h3>
                <p class="mt-1 text-sm font-medium">{categoryLabel(p.category)}</p>
                {p.placeholder && (
                  <PlaceholderTag
                    detail={DEMO_PROJECT_LABEL}
                    class="mt-1 block text-xs font-semibold"
                  />
                )}
                <div class="kadr-more mt-4" id={`kadr-more-${p.id}`}>
                  <p class="text-sm font-semibold">Что я делаю в таком проекте</p>
                  <p class="mt-1 text-lg leading-snug font-bold">
                    {p.roles.map(serviceTitle).join(', ')}
                  </p>
                </div>
                <button
                  type="button"
                  class="kadr-cell-toggle absolute inset-0"
                  aria-expanded="false"
                  aria-controls={`kadr-more-${p.id}`}
                  aria-label={`Открыть кадр: ${p.title}`}
                  data-sheet-toggle
                ></button>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="services" class="border-t-2 border-volt">
      <div class="kadr-wrap py-16 lg:py-24">
        <h2 class="kadr-h2">Услуги</h2>
        <p class="mt-5 max-w-[25em] text-lg font-medium">
          Можно заказать всё вместе или одну часть работы.
        </p>
        <dl class="mt-12">
          {services.map((s) => (
            <div class="grid gap-x-6 gap-y-3 border-t-2 border-volt py-7 lg:grid-cols-12">
              <dt class="text-[clamp(1.75rem,7vw,3.25rem)] leading-[0.95] font-black tracking-[-0.035em] lg:col-span-5">
                {s.displayTitle ?? s.title}
              </dt>
              <dd class="text-lg leading-snug font-semibold lg:col-span-4">{s.summary}</dd>
              <dd class="text-sm leading-relaxed font-medium lg:col-span-3">
                {s.includes.join(', ')}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="travel" class="border-t-2 border-volt">
      <div class="kadr-wrap py-16 lg:py-24">
        <div class="grid gap-x-6 gap-y-6 lg:grid-cols-12">
          <h2 class="kadr-h2 lg:col-span-12">
            {TRAVEL_HEADING.main}
            <span class="mt-3 block text-[clamp(1.25rem,5vw,2rem)] tracking-[-0.02em]">
              {TRAVEL_HEADING.sub}
            </span>
          </h2>
          <p class="max-w-[24em] text-xl leading-snug font-semibold lg:col-span-6 lg:col-start-7">
            {travel.intro}
          </p>
        </div>
        {/* A storyboard: the four steps are a sequence, so they are numbered. */}
        <ol class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-4 lg:gap-x-6">
          {travel.steps.map((step, i) => (
            <li>
              <div class="kadr-slate kadr-board relative aspect-[4/3]">
                <span class="vf" aria-hidden="true"></span>
                <span class="kadr-board-no" aria-hidden="true">
                  {i + 1}
                </span>
              </div>
              <h3 class="mt-3 text-lg font-extrabold">{step.title}</h3>
              <p class="mt-1 text-sm leading-relaxed font-medium">{step.text}</p>
            </li>
          ))}
        </ol>
        <h3 class="mt-12 text-sm font-bold">Что получите</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {travel.formats.map((f) => (
            <li class="border-2 border-volt px-3 py-1.5 text-sm font-semibold">{f}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="about" class="border-t-2 border-volt">
      <div class="kadr-wrap grid items-end gap-x-6 gap-y-8 py-16 lg:grid-cols-12 lg:py-24">
        <div class="relative w-2/3 lg:col-span-4 lg:w-auto">
          <span class="vf" aria-hidden="true"></span>
          <FootageFrame
            tone={{ from: '#0b16a8', to: '#e6e8ff' }}
            paint="none"
            ratio="4 / 5"
            class="kadr-slate"
            description="Портрет Анны"
            placeholderDetail="фото Анны"
            tagClass={tag}
          />
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <h2 class="kadr-h2">Обо мне</h2>
          <p class="mt-6 max-w-[31em] text-xl leading-relaxed font-medium">{person.bio}</p>
          {person.placeholderBio && (
            <PlaceholderTag detail="текст об Анне" class="mt-4 text-sm font-semibold" />
          )}
        </div>
      </div>
    </section>

    <section id="reviews" class="border-t-2 border-volt">
      <div class="kadr-wrap py-16 lg:py-24">
        <h2 class="kadr-h2">Отзывы</h2>
        <div class="mt-12 grid gap-x-6 gap-y-12 lg:grid-cols-12">
          {testimonials.map((t, i) => (
            <figure class:list={['lg:col-span-5', i === 1 && 'lg:col-start-8 lg:mt-24']}>
              <blockquote class="text-[clamp(1.375rem,4.5vw,2rem)] leading-tight font-bold tracking-[-0.02em]">
                {t.quote}
              </blockquote>
              <figcaption class="mt-4 text-sm font-semibold">
                {t.author}
                {t.company && `, ${t.company}`}
                {t.placeholder && <PlaceholderTag detail="реальный отзыв" class="mt-1 block" />}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="border-t-2 border-volt">
      <div class="kadr-wrap pt-16 pb-10 lg:pt-24">
        <div class="relative px-5 py-10 sm:px-10 lg:py-16">
          <span class="vf vf--lg" aria-hidden="true"></span>
          <h2 class="kadr-h2 kadr-h2--xl">Обсудить проект</h2>
          <p class="mt-6 max-w-[24em] text-xl leading-snug font-semibold">
            Напишите, что нужно снять, смонтировать или озвучить. Отвечу и предложу план.
          </p>
        </div>
        <dl class="mt-12 grid gap-x-6 sm:grid-cols-3" data-contacts>
          {contacts.map((c) => (
            <div class="border-t-2 border-volt py-4">
              <dt class="text-2xl font-black tracking-[-0.02em]">{c.label}</dt>
              <dd class="mt-1 text-sm font-semibold">
                {c.href ? (
                  <a href={c.href}>{c.value}</a>
                ) : (
                  <PlaceholderTag detail="контакт появится" />
                )}
              </dd>
            </div>
          ))}
        </dl>
        <footer class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t-2 border-volt pt-4 text-sm font-semibold">
          <a href={withBase('/design/')} class="kadr-tap gap-2" data-testid="back-to-design">
            <Icon name="back" class="size-4" /> Все концепции
          </a>
          <p>Концепция «Кадр». Работы, отзывы и контакты — заглушки.</p>
        </footer>
      </div>
    </section>
  </main>

  <dialog
    id="kadr-reel"
    data-dialog
    aria-label="Шоурил"
    class="kadr-dialog m-auto w-[min(72rem,calc(100vw-2rem))] max-w-none bg-paper p-0 text-volt backdrop:bg-volt/85"
  >
    <div class="flex h-14 items-center justify-between border-b-2 border-volt px-4">
      <p class="font-extrabold">Шоурил</p>
      <button
        type="button"
        class="-mr-2.5 grid size-11 place-items-center"
        data-dialog-close
        aria-label="Закрыть шоурил"
      >
        <Icon name="close" />
      </button>
    </div>
    <div class="p-4 sm:p-6">
      <div class="relative">
        <span class="vf" aria-hidden="true"></span>
        <FootageFrame
          tone={{ from: '#0b16a8', to: '#e6e8ff' }}
          paint="none"
          ratio="16 / 9"
          class="kadr-slate"
          description="Видео шоурила"
          placeholderDetail="видео шоурила"
          tagClass={tag}
        />
      </div>
      <p class="mt-4 text-sm font-semibold">Здесь будет плеер со звуком, когда появится шоурил.</p>
    </div>
  </dialog>
</div>

<script>
  import { initDialogs } from '../../../lib/ui/dialog';
  import { initFilters } from '../../../lib/ui/filter';
  import { initMenus } from '../../../lib/ui/menu';

  initMenus();
  initDialogs();
  initFilters();

  // Contact sheet: one frame open at a time, blown up in place.
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-sheet-toggle]')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  const setOpen = (target: HTMLButtonElement | null) => {
    for (const toggle of toggles) {
      const open = toggle === target;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.closest('.kadr-cell')?.toggleAttribute('data-open', open);
    }
  };
  const apply = (target: HTMLButtonElement | null) => {
    if (document.startViewTransition && !reduce.matches) {
      document.startViewTransition(() => setOpen(target));
    } else {
      setOpen(target);
    }
  };

  for (const toggle of toggles) {
    toggle.addEventListener('click', () => {
      apply(toggle.getAttribute('aria-expanded') === 'true' ? null : toggle);
    });
  }
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = toggles.find((t) => t.getAttribute('aria-expanded') === 'true');
    if (!open || document.querySelector('dialog[open], [data-menu-modal]:not([hidden])')) return;
    apply(null);
    open.focus();
  });
</script>

<style is:global>
  html:has(.kadr) {
    scrollbar-color: var(--color-volt) var(--color-paper);
  }
  html[data-menu-open] {
    overflow: hidden;
  }
  /* Electric blue marks what matters: name, headings, frames, actions. Running
     text and meta stay deep blue, so the accent keeps its weight. */
  .kadr-name,
  .kadr-h2,
  .kadr dt,
  .kadr h3,
  .vf,
  .kadr-frame-no,
  .kadr-board-no,
  .kadr-slate-mark,
  .kadr-btn,
  .kadr-filter,
  .kadr-tap,
  .kadr-link,
  .kadr blockquote {
    color: var(--color-volt);
  }
  .kadr-btn--solid,
  .kadr-btn:hover {
    color: var(--color-paper);
  }
  .kadr :focus-visible {
    outline: 3px solid var(--color-volt);
    outline-offset: 3px;
  }
  .kadr .bg-volt :focus-visible {
    outline-color: var(--color-paper);
  }
  .kadr ::selection {
    background: var(--color-volt);
    color: var(--color-paper);
  }

  /* Safe-area margins: the layout's outer frame is the device's own. */
  .kadr-wrap {
    margin-inline: auto;
    max-width: var(--container-wide);
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(1rem, env(safe-area-inset-right));
  }
  @media (min-width: 64rem) {
    .kadr-wrap {
      padding-left: max(2rem, env(safe-area-inset-left));
      padding-right: max(2rem, env(safe-area-inset-right));
    }
  }

  /* In the components layer so responsive utilities (lg:hidden) still win. */
  @layer components {
    .kadr-tap {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
    }
  }
  .kadr-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0 0.75rem;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  .kadr-link:hover {
    text-decoration-color: currentColor;
  }

  /* The name fills the top third: two lines of one heavy word each. */
  .kadr-name {
    font-size: clamp(2.5rem, 14.3vw, 13rem);
    font-weight: 900;
    line-height: 0.84;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .kadr-h2 {
    font-size: clamp(2.75rem, 11vw, 8rem);
  }
  @media (min-width: 64rem) {
    .kadr-h2 {
      font-size: min(9.4vw, 7.5rem);
    }
  }
  .kadr-h2 {
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .kadr-h2--xl {
    font-size: clamp(2.5rem, 10.4vw, 11rem);
  }

  /* Rule-of-thirds guides, drawn from the same 12-column grid the content uses:
     verticals run down the gutters before columns 5 and 9, which is where the
     name and the frame start. Desktop only; on phones they would cut through text. */
  .kadr-hero .kadr-wrap {
    --gap: 1.5rem;
    --col: calc((100% - 11 * var(--gap)) / 12);
    --third: calc(4 * var(--col) + 4 * var(--gap));
  }
  .kadr-guides {
    display: none;
  }
  @media (min-width: 64rem) {
    .kadr-guides {
      position: absolute;
      inset: 0 max(2rem, env(safe-area-inset-right)) 0 max(2rem, env(safe-area-inset-left));
