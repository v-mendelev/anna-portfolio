---
/** Home page: the whole site (see src/site/components/HomePage.astro). */
import HomePage from '../site/components/HomePage.astro';
import SiteLayout from '../site/components/SiteLayout.astro';
import { content } from '../site/content';
import { siteConfig } from '../site/site.config';

// Structured data: only facts from content (name, profession, services).
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: content.person.name,
  jobTitle: content.person.role,
  url: Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined,
  knowsAbout: content.services.map((s) => s.title),
};
---

<SiteLayout fullTitle={siteConfig.homeTitle}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <HomePage />
</SiteLayout>
