---
/**
 * Concept C — Creative: "the montage poster".
 * Built on the grammar of 1920s constructivist film posters (diagonals,
 * lens circles, heavy type, flat colour), without any political symbols,
 * printed on warm ivory. Colour has jobs, not equal shares:
 *  - plum is the ink: type, dark "screening" sections, the header bar;
 *  - coral is the signal: the lens, the primary action, active moments;
 *  - sage is the field: the travel spread and one quiet band.
 * Motion is purposeful and filmic:
 *  - the showreel opens with an iris wipe from the button you pressed;
 *  - service words slide along their diagonal bands as you scroll;
 *  - frames in the montage can be pulled forward to read them.
 */
import FootageFrame from '../../ui/FootageFrame.astro';
import Icon from '../../ui/Icon.astro';
import PlaceholderTag from '../../ui/PlaceholderTag.astro';
import { withBase } from '../../../lib/paths';
import { usedCategories } from '../../../lib/portfolio';
import {
  DEMO_PROJECT_LABEL,
  DEMO_WORK_NOTE,
  HERO,
  SECTIONS,
  TRAVEL_HEADING,
  categoryLabel,
  content,
  serviceTitle,
} from '../../../site/content';

const { person, services, projects, travel, testimonials, contacts } = content;
const categories = usedCategories(content.categories, projects);
const navLinks = SECTIONS.filter((s) => ['work', 'services', 'travel', 'contact'].includes(s.id));
/** Diagonal service bands: each pairing is a contrast-safe text pair. */
const bands = [
  { band: 'bg-cr-coral text-cr-plum -rotate-3', title: '', body: '' },
  { band: 'bg-cr-plum text-cr-ivory rotate-2', title: 'text-cr-coral', body: 'text-cr-ivory' },
  { band: 'bg-cr-sage text-cr-plum -rotate-2', title: '', body: '' },
  { band: 'bg-cr-plum text-cr-ivory rotate-3', title: 'text-cr-ivory', body: 'text-cr-ivory' },
];
const tilts = ['-rotate-2', 'rotate-1', 'rotate-2', '-rotate-1', 'rotate-1', '-rotate-2'];
const tag = 'absolute top-2 left-2 bg-cr-plum px-2 py-0.5 text-xs text-cr-ivory';
const reviewCards = ['bg-cr-coral md:-rotate-1', 'bg-cr-sage md:mt-16 md:rotate-1'];
---

<div class="cr overflow-x-clip bg-cr-ivory font-cr-text text-cr-plum" data-concept="creative">
  <header class="cr-header group pointer-events-none fixed inset-x-0 top-0 z-40" data-site-header>
    <div class="cr-header-row mx-auto flex max-w-wide items-center justify-between px-4 pt-4 sm:px-8 sm:pt-6">
      <a
        href="#top"
        class="pointer-events-auto grid size-12 place-items-center rounded-full bg-cr-coral font-cr-display text-sm font-bold text-cr-plum ring-2 ring-cr-ivory"
        aria-label={`${person.name}: в начало страницы`}
      >
        АШ
      </a>
      <div class="pointer-events-auto flex items-center gap-1 rounded-full bg-cr-plum p-1 ring-2 ring-cr-ivory">
        <nav aria-label="Разделы" class="hidden lg:flex">
          {navLinks.map((s) => (
            <a href={`#${s.id}`} class="cr-navlink">
              {s.label}
            </a>
          ))}
        </nav>
        <button
          type="button"
          class="flex min-h-11 items-center gap-2 rounded-full px-5 text-sm font-medium text-cr-ivory"
          data-menu-toggle
          aria-controls="cr-menu"
          aria-expanded="false"
        >
          <Icon name="menu" class="size-4" />
          Меню
        </button>
      </div>
    </div>
  </header>

  <div
    id="cr-menu"
    class="fixed inset-0 z-50 overflow-y-auto bg-cr-plum text-cr-ivory"
    role="dialog"
    aria-modal="true"
    aria-label="Меню"
    data-menu-modal
    hidden
  >
    <div class="mx-auto flex max-w-wide items-center justify-between px-4 pt-4 sm:px-8 sm:pt-6">
      <span class="font-cr-display text-sm font-bold">{person.name}</span>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-full bg-cr-coral text-cr-plum"
        data-menu-close
        aria-label="Закрыть меню"
      >
        <Icon name="close" />
      </button>
    </div>
    <nav aria-label="Меню" class="mx-auto max-w-wide px-4 py-8 sm:px-8">
      <ul class="space-y-1">
        {SECTIONS.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              class="inline-flex min-h-12 items-center font-cr-display text-[clamp(2rem,8vw,4.5rem)] leading-tight font-black uppercase hover:text-cr-coral"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={withBase('/design/')} class="mt-10 inline-flex min-h-11 items-center gap-2 text-sm">
        <Icon name="back" class="size-4" /> Все концепции
      </a>
    </nav>
  </div>

  <main id="main">
    <section id="top" class="relative min-h-[100svh] overflow-hidden pt-24 pb-40 sm:pt-28">
      <div class="mx-auto grid max-w-wide grid-cols-12 items-center gap-y-10 px-4 sm:px-8">
        <div class="relative z-10 col-span-12 lg:col-span-7">
          <h1 class="cr-title font-cr-display leading-[0.88] font-black uppercase">
            <span class="block text-[clamp(1.75rem,7vw,3.5rem)]">Анна</span>
            <span class="block -rotate-6 text-[clamp(2rem,10.6vw,6rem)] tracking-[-0.03em] lg:text-[clamp(3rem,6vw,5.5rem)]">
              Шеленкова
            </span>
          </h1>
          <p class="mt-10 max-w-[36ch] text-lg leading-relaxed font-medium lg:mt-14">{HERO.lead}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <button
              type="button"
              class="cr-btn border-2 border-cr-plum bg-cr-coral text-cr-plum"
              data-dialog-open="cr-reel"
              data-testid="showreel-open"
            >
              <Icon name="play" class="size-4" /> Смотреть шоурил
            </button>
            <a href="#contact" class="cr-btn border-2 border-cr-plum">
              Обсудить проект
            </a>
          </div>
        </div>
        <div class="relative col-span-12 justify-self-center lg:col-span-5">
          <div class="cr-lens relative size-[min(78vw,30rem)] rounded-full bg-cr-coral p-[6%]">
            <span
              class="absolute -inset-3 rounded-full border-2 border-dashed border-cr-plum/40"
              aria-hidden="true"
            ></span>
            <FootageFrame
              tone={{ from: '#302536', to: '#f2b48f', horizon: 60, sunX: 64, sunY: 34 }}
              ratio="1"
              class="h-full w-full rounded-full"
              description="Кадр из шоурила"
              placeholderDetail="кадр"
              tagClass="absolute bottom-[18%] left-1/2 -translate-x-1/2 bg-cr-plum px-2 py-0.5 text-xs text-cr-ivory"
              eager
            />
          </div>
        </div>
      </div>
      <div class="cr-band-wrap absolute inset-x-0 bottom-10" aria-hidden="true">
        <div class="-mx-[5%] -rotate-3 bg-cr-plum py-3 text-cr-ivory">
          <div class="flex w-max items-center gap-6 px-[6%] font-cr-display text-xl font-black uppercase sm:text-3xl">
            {services.map((s) => (
              <>
                <span>{s.title}</span>
                <span class="size-3 shrink-0 rounded-full bg-cr-coral sm:size-4" />
              </>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="showreel" class="bg-cr-plum text-cr-ivory">
      <div class="mx-auto grid max-w-wide items-center gap-12 px-4 py-24 sm:px-8 md:grid-cols-2 lg:py-32">
        <div>
          <h2 class="font-cr-display text-[clamp(2.5rem,9vw,6rem)] leading-[0.9] font-black text-cr-coral uppercase md:text-[clamp(2.5rem,6vw,6rem)]">
            Шоурил
          </h2>
          <p class="mt-6 max-w-[36ch] text-lg">
            Лучшие кадры из разных проектов: съёмка, монтаж и голос. Включайте со звуком.
          </p>
          <p class="mt-4 text-sm">
            <PlaceholderTag detail="видео появится позже" />
          </p>
        </div>
        <button
          type="button"
          class="group relative mx-auto grid aspect-square w-[min(70vw,22rem)] place-items-center rounded-full border-[6px] border-cr-coral"
          data-dialog-open="cr-reel"
          aria-label="Смотреть шоурил"
        >
          <span class="grid size-2/3 place-items-center rounded-full bg-cr-coral text-cr-plum transition-transform duration-300 ease-out group-hover:scale-105">
            <Icon name="play" class="ml-2 size-14" />
          </span>
        </button>
      </div>
    </section>

    <section id="work" class="py-24 lg:py-32">
      <div
        class="mx-auto max-w-page px-4 sm:px-6 lg:px-8"
        data-testid="page-container"
        data-filter-root
      >
        <h2 class="font-cr-display text-[clamp(2.5rem,9vw,6rem)] leading-[0.9] font-black uppercase">
          Работы
        </h2>
        <p
          class="mt-6 max-w-[52ch] -rotate-1 bg-cr-coral px-4 py-3 text-base leading-relaxed font-medium text-cr-plum"
          data-demo-note
        >
          {DEMO_WORK_NOTE}
        </p>
        <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Фильтр работ">
          <button type="button" class="cr-chip" data-filter="all" aria-pressed="true">
            Все
          </button>
          {categories.map((c) => (
            <button type="button" class="cr-chip" data-filter={c.id} aria-pressed="false">
              {c.label}
            </button>
          ))}
        </div>
        <p
          class="mt-3 text-sm font-medium"
          data-filter-status
          data-template="Показано работ: {n}"
          aria-live="polite"
        >
          Показано работ: {projects.length}
        </p>
        <p class="mt-1 text-sm">Нажмите на кадр, чтобы узнать, что я делаю в таком проекте.</p>
        <ul class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8" data-project-list>
          {projects.map((p, i) => (
            <li data-category={p.category} class="cr-montage-item">
              <article
                class:list={[
                  'cr-card relative border-2 border-cr-plum bg-cr-paper p-3 pb-4',
                  tilts[i % tilts.length],
                ]}
                data-card
              >
                <FootageFrame
                  tone={p.tone}
                  ratio={null}
                  class="aspect-[3/2] sm:aspect-[4/3]"
                  description={`Кадр из проекта «${p.title}»`}
                  placeholder={p.placeholder}
                  placeholderDetail={DEMO_PROJECT_LABEL}
                  tagClass={tag}
                />
                <h3 class="mt-3 font-cr-display text-base leading-tight font-bold">{p.title}</h3>
                <p class="mt-1 text-sm">{categoryLabel(p.category)}</p>
                <p class="cr-card-more mt-2 text-sm" id={`cr-more-${p.id}`}>
                  Что я делаю в таком проекте: {p.roles.map(serviceTitle).join(', ').toLowerCase()}
                </p>
                <button
                  type="button"
                  class="absolute inset-0"
                  aria-expanded="false"
                  aria-controls={`cr-more-${p.id}`}
                  aria-label={`Подробнее о проекте: ${p.title}`}
                  data-card-toggle
                />
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="services" class="overflow-x-clip py-20 lg:py-28">
      <h2 class="mx-auto max-w-wide px-4 font-cr-display text-[clamp(2.5rem,9vw,6rem)] leading-[0.9] font-black uppercase sm:px-8">
        Услуги
      </h2>
      <ul class="mt-14 space-y-6">
        {services.map((s, i) => {
          const b = bands[i % bands.length] ?? bands[0];
          return (
            <li class:list={['-mx-[5%] px-[5%] py-8 sm:py-10', b?.band]}>
              <div class="mx-auto grid max-w-wide items-end gap-4 px-4 sm:px-8 lg:grid-cols-12">
                <h3
                  class:list={[
                    'cr-slide font-cr-display text-[clamp(1.6rem,8.2vw,5.5rem)] leading-none font-black uppercase lg:col-span-7 lg:text-[clamp(2rem,4.2vw,4rem)]',
                    b?.title,
                  ]}
                >
                  {s.displayTitle ?? s.title}
                </h3>
                <div class:list={['lg:col-span-5', b?.body]}>
                  <p class="text-lg font-medium">{s.summary}</p>
                  <p class="mt-2 text-sm">{s.includes.join(', ')}</p>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <section id="travel" class="bg-cr-sage text-cr-plum">
      <div class="mx-auto max-w-wide px-4 py-24 sm:px-8 lg:py-32">
        <div class="grid gap-8 lg:grid-cols-12">
          <h2 class="font-cr-display text-[clamp(1.75rem,8.6vw,6rem)] leading-[0.9] font-black uppercase lg:col-span-12">
            {TRAVEL_HEADING.main}
            <span class="mt-2 block text-[clamp(1.1rem,5vw,2.5rem)] tracking-normal normal-case">
              {TRAVEL_HEADING.sub}
            </span>
          </h2>
          <p class="max-w-[40ch] text-xl leading-relaxed font-medium lg:col-span-6 lg:col-start-7">
            {travel.intro}
          </p>
        </div>
        <ol class="mt-16 grid gap-10 md:grid-cols-4 md:gap-6">
          {travel.steps.map((step, i) => (
            <li class="cr-step" style={`--step: ${i}`}>
              <span
                class="grid size-16 place-items-center rounded-full bg-cr-plum font-cr-display text-2xl font-black text-cr-coral"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <h3 class="mt-4 font-cr-display text-xl font-bold">{step.title}</h3>
              <p class="mt-2 max-w-[30ch]">{step.text}</p>
            </li>
          ))}
        </ol>
        <div class="mt-16 flex flex-wrap gap-3">
          {travel.formats.map((f) => (
            <span class="rounded-full bg-cr-ivory px-4 py-2 text-sm font-medium text-cr-plum">
              {f}
            </span>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="py-24 lg:py-32">
      <div class="mx-auto grid max-w-wide items-center gap-12 px-4 sm:px-8 md:grid-cols-12">
        <div class="md:col-span-5">
          <div class="relative size-[min(70vw,24rem)] rounded-full border-[10px] border-cr-plum">
            <FootageFrame
              tone={{ from: '#3a2a33', to: '#e8b49c' }}
              ratio="1"
              class="h-full w-full rounded-full"
              description="Портрет Анны"
              placeholderDetail="фото Анны"
              tagClass="absolute bottom-[14%] left-1/2 -translate-x-1/2 bg-cr-plum px-2 py-0.5 text-xs text-cr-ivory"
            />
            <span
              class="absolute -top-2 -right-2 size-16 rounded-full bg-cr-coral sm:size-20"
              aria-hidden="true"
            ></span>
          </div>
        </div>
        <div class="md:col-span-7">
          <h2 class="font-cr-display text-[clamp(2.5rem,9vw,6rem)] leading-[0.9] font-black uppercase">
            Обо мне
          </h2>
          <p class="mt-8 max-w-[52ch] text-xl leading-relaxed">{person.bio}</p>
          {person.placeholderBio && (
            <PlaceholderTag detail="текст об Анне" class="mt-4 text-sm font-medium" />
          )}
        </div>
      </div>
    </section>

    <section id="reviews" class="bg-cr-paper py-24 lg:py-32">
      <div class="mx-auto max-w-wide px-4 sm:px-8">
        <h2 class="font-cr-display text-[clamp(2.5rem,9vw,6rem)] leading-[0.9] font-black uppercase">
          Отзывы
        </h2>
        <div class="mt-14 grid gap-10 md:grid-cols-2">
          {testimonials.map((t, i) => (
            <figure
              class:list={[
                'border-4 border-cr-plum p-6 text-cr-plum sm:p-8',
                reviewCards[i % reviewCards.length],
              ]}
            >
              <blockquote class="font-cr-display text-xl leading-snug font-bold sm:text-2xl">
                {t.quote}
              </blockquote>
              <figcaption class="mt-5 text-sm font-medium">
                {t.author}
                {t.company && `, ${t.company}`}
                {t.placeholder && (
                  <span class="mt-2 block">
                    <PlaceholderTag detail="реальный отзыв" />
                  </span>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="bg-cr-plum text-cr-ivory">
      <div class="mx-auto max-w-wide px-4 pt-24 pb-10 sm:px-8 lg:pt-32">
        <h2 class="font-cr-display text-[clamp(2rem,10.5vw,6rem)] leading-[0.88] font-black uppercase">
          <span class="block text-cr-coral">Напишите</span>
          <span class="block pl-[10%]">мне</span>
        </h2>
        <p class="mt-8 max-w-[44ch] text-lg">Что снимаем, где и когда? Отвечу и предложу план.</p>
        <ul class="mt-12 grid gap-4 sm:grid-cols-3" data-contacts>
          {contacts.map((c) => (
            <li class="border-2 border-cr-coral p-5">
              <p class="font-cr-display text-xl font-bold text-cr-coral">{c.label}</p>
              <p class="mt-2 text-sm">
                {c.href ? (
                  <a href={c.href}>{c.value}</a>
                ) : (
                  <PlaceholderTag detail="контакт появится" />
                )}
              </p>
            </li>
          ))}
        </ul>
        <footer class="mt-20 flex flex-wrap items-center justify-between gap-4 border-t border-cr-ivory/30 pt-6 text-sm">
          <a
            href={withBase('/design/')}
            class="inline-flex min-h-11 items-center gap-2 hover:text-cr-coral"
            data-testid="back-to-design"
          >
            <Icon name="back" class="size-4" /> Все концепции
          </a>
          <p>Концепция C. Работы, отзывы и контакты — заглушки.</p>
        </footer>
      </div>
    </section>
  </main>

  <dialog
    id="cr-reel"
    data-dialog
    aria-label="Шоурил"
    class="cr-dialog fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none bg-cr-plum p-0 text-cr-ivory backdrop:bg-transparent"
  >
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between px-4 pt-4 sm:px-8 sm:pt-6">
        <p class="font-cr-display text-lg font-black text-cr-coral uppercase">Шоурил</p>
        <button
          type="button"
          class="grid size-11 place-items-center rounded-full bg-cr-coral text-cr-plum"
          data-dialog-close
          aria-label="Закрыть шоурил"
        >
          <Icon name="close" />
        </button>
      </div>
      <div class="flex flex-1 flex-col items-center justify-center gap-6 px-4 pb-10">
        <FootageFrame
          tone={{ from: '#302536', to: '#f2b48f', horizon: 60, sunX: 64, sunY: 34 }}
          ratio="16 / 9"
          class="w-full max-w-5xl"
          description="Видео шоурила"
          placeholderDetail="видео шоурила"
          tagClass={tag}
        />
        <p class="max-w-[46ch] text-center">
          Здесь будет плеер со звуком, когда Анна пришлёт шоурил.
        </p>
      </div>
    </div>
  </dialog>
</div>

<script>
  import { initDialogs } from '../../../lib/ui/dialog';
  import { initFilters } from '../../../lib/ui/filter';
  import { initHeaderState } from '../../../lib/ui/header';
  import { initMenus } from '../../../lib/ui/menu';

  initMenus();
  initDialogs();
  initFilters();
  initHeaderState();

  // Montage: pull one frame forward at a time.
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-card-toggle]')];
  for (const toggle of toggles) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      for (const other of toggles) {
        other.setAttribute('aria-expanded', 'false');
        other.closest('[data-card]')?.removeAttribute('data-front');
      }
      if (!expanded) {
        toggle.setAttribute('aria-expanded', 'true');
        toggle.closest('[data-card]')?.setAttribute('data-front', '');
      }
    });
  }
</script>

<style is:global>
  html:has(.cr) {
    scrollbar-color: var(--color-cr-plum) var(--color-cr-ivory);
  }
  html[data-menu-open] {
    overflow: hidden;
  }
  .cr :focus-visible {
    outline-color: var(--color-cr-plum);
    outline-width: 3px;
  }
  .cr [class*='bg-cr-plum'] :focus-visible,
  .cr-header[data-scrolled] :focus-visible,
  .cr-dialog :focus-visible {
    outline-color: var(--color-cr-coral);
  }
  .cr ::selection {
    background: var(--color-cr-coral);
    color: var(--color-cr-plum);
  }

  /* Floating at rest; once content passes beneath, the header becomes a plum
     bar so the badge and menu never sit on top of headings or text. */
  .cr-header {
    transition: background-color 0.25s ease-out;
  }
  .cr-header[data-scrolled] {
    pointer-events: auto;
    background: var(--color-cr-plum);
    border-bottom: 3px solid var(--color-cr-coral);
  }
  .cr-header-row {
    transition: padding 0.25s ease-out;
  }
  .cr-header[data-scrolled] .cr-header-row {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }
  .cr-header[data-scrolled] .ring-cr-ivory {
    --tw-ring-color: transparent;
  }

  .cr-btn {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 0.6rem;
    border-radius: 999px;
    padding: 0 1.5rem;
    font-weight: 600;
    transition: transform 0.2s ease-out;
  }
  .cr-btn:hover {
    transform: translateY(-2px);
  }

  .cr-chip {
    min-height: 2.75rem;
    border-radius: 999px;
    border: 2px solid var(--color-cr-plum);
    background: var(--color-cr-paper);
    padding: 0 1.1rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .cr-chip[aria-pressed='true'] {
    background: var(--color-cr-plum);
    color: var(--color-cr-ivory);
  }

  /* Phone montage: frames at 86% width, alternating sides. Count only visible
     items, so the stagger survives the filter (filtered cards get [hidden]). */
  @media (max-width: 39.99rem) {
