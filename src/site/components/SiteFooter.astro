---
/** Footer: name, a way back up, and an honest note while content is pending. */
import { content } from '../content';

const { person, projects, showreel, contacts } = content;
const pending =
  person.placeholderBio ||
  showreel.placeholder ||
  projects.some((p) => p.placeholder) ||
  contacts.some((c) => c.placeholder);
const year = new Date().getFullYear();
---

<footer class="kadr-wrap pb-10" data-page-region>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t-2 border-volt pt-4 text-sm font-semibold">
    <p>
      © {year} {person.name}
    </p>
    {pending && (
      <p data-footer-note>Сайт наполняется: работы, шоурил, фото и контакты — заглушки.</p>
    )}
    <a href="#top" class="kadr-tap kadr-link -mr-3">
      Наверх
    </a>
  </div>
</footer>
