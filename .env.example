# Copy to `.env` for local overrides. Never commit `.env` or real secrets.
# Only variables prefixed with PUBLIC_ are exposed to the browser bundle.

# --- Build / deploy (read by astro.config.ts from the PROCESS environment) ---
# Note: astro.config.ts reads process.env, which is NOT populated from .env.
# Set these in the shell / CI, or use the scripts: pnpm build:pages, pnpm build:timeweb.
#   PowerShell: $env:DEPLOY_TARGET='github-pages'; pnpm build
# local | github-pages | timeweb
DEPLOY_TARGET=local
# Absolute origin of the deployed site, e.g. https://user.github.io
# Leave empty to use per-target defaults from src/site/site.config.ts.
SITE_URL=
# Path prefix, e.g. /anna-portfolio for GitHub Pages project sites, / for a domain root.
# Leave unset to use per-target defaults.
# BASE_PATH=

# --- Public runtime config (embedded into the static bundle) ---
# Backend API for the feedback form (Telegram/CRM are reached via this backend).
# Empty = form disabled.
PUBLIC_API_BASE_URL=
# "true" only for the real production site. Demos/staging stay noindex.
PUBLIC_SITE_INDEXABLE=false
# Root URL of portfolio media (posters, video previews) on S3/CDN, e.g.
# https://cdn.example.ru/portfolio/ . Empty = files committed in public/media/.
# Keys are the same in both places (see docs/MEDIA.md).
PUBLIC_MEDIA_BASE_URL=

# --- Server-side secrets (NOT used by this static site; for the future backend only) ---
# Keep them in GitHub Actions secrets / Timeweb environment, never in the repo.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# CRM_API_KEY=
