---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CutLine from '../../components/demo/skleyka/CutLine.astro';
import Container from '../../components/ui/Container.astro';
import FontFaces from '../../components/ui/FontFaces.astro';
import { fontSets } from '../../site/fonts';
import { withBase } from '../../lib/paths';
import { demos, type DemoSlug } from '../../site/demos';
import { siteConfig } from '../../site/site.config';

/** Each card previews its concept in that concept's own type and composition. */
const preview: Record<DemoSlug, { panel: string; label: string }> = {
  cinematic: { panel: 'bg-paper text-volt', label: 'Сетка видоискателя' },
  editorial: { panel: 'bg-paper text-pitch', label: 'Разрезанные заголовки' },
  creative: { panel: 'bg-volt text-paper', label: 'Типографика в движении' },
};
---

<BaseLayout title="Выбор демоверсии">
  <FontFaces slot="head" set={fontSets.chooser} />
  <Container as="main" id="main" class="py-12 sm:py-20" data-testid="page-container">
    <p class="text-sm text-ink-muted">{siteConfig.name}</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-balance sm:text-5xl">
      Выберите демоверсию дизайна
    </h1>
    <p class="mt-4 max-w-prose text-base text-ink-muted sm:text-lg">
      Три направления одного сайта-портфолио: белый фон, электрический синий, тяжёлый гротеск.
      Содержание одинаковое. Работы, отзывы и контакты пока заглушки.
    </p>
    <ul class="mt-10 grid gap-6 md:grid-cols-3" data-testid="demo-list">
      {demos.map((demo) => (
        <li>
          <a
            href={withBase(`/design/${demo.slug}/`)}
            data-testid={`demo-link-${demo.slug}`}
            class="group block h-full overflow-hidden rounded-xl border border-line bg-surface-raised transition-colors hover:border-volt"
          >
            <span
              class:list={[
                'chooser-panel relative grid aspect-[4/3] place-items-center overflow-hidden border-b border-line',
                preview[demo.slug].panel,
              ]}
            >
              {demo.slug === 'cinematic' && (
                <>
                  <span class="chooser-vf" aria-hidden="true" />
                  <span
                    class="font-kadr text-6xl font-black tracking-[-0.045em] uppercase"
                    set:text={demo.title}
                  />
                </>
              )}
              {demo.slug === 'editorial' && (
                <CutLine
                  text={demo.title}
                  shift="0.08em"
                  class="chooser-cut font-sk-display text-7xl leading-[0.8] font-extrabold uppercase"
                />
              )}
              {demo.slug === 'creative' && (
                <span
                  class="text-8xl leading-none font-[900] uppercase"
                  style="font-family: var(--font-rp-condensed); font-stretch: 62.5%"
                  set:text={demo.title}
                />
              )}
            </span>
            <span class="block p-5">
              <span class="block text-lg font-semibold">{preview[demo.slug].label}</span>
              <span class="mt-2 block text-sm leading-relaxed text-ink-muted">{demo.summary}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</BaseLayout>

<style is:global>
  .chooser-vf {
    position: absolute;
    inset: 1.25rem;
    background:
      linear-gradient(currentColor, currentColor) left top / 1.25rem 3px no-repeat,
      linear-gradient(currentColor, currentColor) left top / 3px 1.25rem no-repeat,
      linear-gradient(currentColor, currentColor) right top / 1.25rem 3px no-repeat,
      linear-gradient(currentColor, currentColor) right top / 3px 1.25rem no-repeat,
      linear-gradient(currentColor, currentColor) left bottom / 1.25rem 3px no-repeat,
      linear-gradient(currentColor, currentColor) left bottom / 3px 1.25rem no-repeat,
      linear-gradient(currentColor, currentColor) right bottom / 1.25rem 3px no-repeat,
      linear-gradient(currentColor, currentColor) right bottom / 3px 1.25rem no-repeat;
  }
  /* The chooser shows the cut already split (no scroll animation here). */
  .chooser-cut.sk-cut {
    position: relative;
    display: block;
    white-space: nowrap;
  }
  .chooser-cut .sk-cut-a {
    display: block;
    clip-path: inset(0 0 50% 0);
  }
  .chooser-cut .sk-cut-b {
    position: absolute;
    inset: 0;
    color: var(--color-volt);
    clip-path: inset(50% 0 0 0);
    transform: translateX(var(--cut-shift));
  }
</style>
